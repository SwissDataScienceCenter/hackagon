oidc:
  # Needed if you switch hackagon-frontend to a confidential client:
  # (Client authentication: On).
  # In dev: generate with: openssl rand -base64 32
  clientSecret: "replace-with-output-of-openssl-rand-base64-32"

  # Secret used to sign the auth.js session JWT cookie.
  # Generate with: openssl rand -base64 32
  # Any random string works in dev — must be kept secret in production.
  authSecret: "replace-with-output-of-openssl-rand-base64-32"
