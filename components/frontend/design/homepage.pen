                              ]
                            },
                            { "id": "hli-qa-prefs", "type": "ref", "ref": "hli-qa-btn", "descendants": { "qb-icon": { "iconFontName": "list-ordered" }, "qb-text": { "content": "Set Preferences" } } },
                            { "id": "hli-qa-submit", "type": "ref", "ref": "hli-qa-btn", "descendants": { "qb-icon": { "iconFontName": "upload" }, "qb-text": { "content": "Submit Project" } }, "fill": "$color.surfaceRaised" },
