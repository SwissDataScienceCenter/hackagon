                                { "id": "hli-t2-count", "type": "text", "content": "7 proposals", "fill": "$color.textMuted", "fontFamily": "$font.mono", "fontSize": 11 }
                              ]
                            }
                          ]
                        },
                        {
                          "id": "hli-prop-item",
                          "name": "Proposal List Item (sample)",
                          "type": "frame",
                          "reusable": true,
                          "width": "fill_container", "height": "fit_content",
                          "fill": "$color.bg",
                          "stroke": { "align": "inside", "thickness": 1, "fill": "$color.border" },
                          "layout": "horizontal", "gap": 12, "alignItems": "center",
                          "padding": 12,
                          "children": [
