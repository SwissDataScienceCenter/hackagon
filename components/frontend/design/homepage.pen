              ]
            },
            { "id": "tm-tab-submissions", "type": "ref", "ref": "tm-tab-inactive", "descendants": { "tm-ti-text": { "content": "Submissions" } } },
            { "id": "tm-tab-timeline", "type": "ref", "ref": "tm-tab-inactive", "descendants": { "tm-ti-text": { "content": "Timeline" } } },
            { "id": "tm-tab-webinars", "type": "ref", "ref": "tm-tab-inactive", "descendants": { "tm-ti-text": { "content": "Webinars" } } },
