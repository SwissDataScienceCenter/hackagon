    {
      "id": "dashboard",
      "name": "Dashboard — Logged In (/welcome, Desktop 1440px)",
      "context": "Like HuggingFace logged-in dashboard. Shows user's active hackathons, their teams, notifications, and past participation. Replaces the public hero with a personal feed. This is the /welcome route.",
      "type": "frame",
      "x": 1560, "y": 0,
      "width": 1440,
      "height": "fit_content",
      "fill": "$color.bg",
      "layout": "vertical",
      "clip": true,
      "children": [

        {
          "id": "dash-nav",
          "type": "ref", "ref": "nav-bar",
          "descendants": {
            "nav-login-btn": {
              "id": "nav-user-avatar",
              "type": "frame", "width": 32, "height": 32,
              "fill": "$color.primary",
              "layout": "horizontal", "justifyContent": "center", "alignItems": "center",
              "children": [
                { "id": "nav-user-initial", "type": "text", "content": "S", "fill": "$color.onPrimary", "fontFamily": "$font.mono", "fontSize": 14, "fontWeight": "700" }
              ]
            }
          }
        },

        {
          "id": "dash-welcome",
          "name": "Dashboard Welcome Banner",
          "type": "frame",
          "width": "fill_container", "height": "fit_content",
          "fill": "$color.bg",
          "layout": "horizontal", "justifyContent": "space_between", "alignItems": "center",
          "padding": [32, 80, 32, 80],
          "stroke": { "align": "inside", "thickness": { "bottom": 1 }, "fill": "$color.border" },
          "children": [
            {
              "id": "dash-greeting",
              "type": "frame", "width": "fit_content", "height": "fit_content",
              "layout": "vertical", "gap": 4,
              "children": [
                { "id": "dash-hello", "type": "text", "content": "Welcome back, Sabine", "fill": "$color.text", "fontFamily": "$font.mono", "fontSize": 24, "fontWeight": "700" },
                { "id": "dash-summary", "type": "text", "content": "You are registered in 1 active hackathon  ·  2 notifications", "fill": "$color.textSecondary", "fontFamily": "$font.mono", "fontSize": 13 }
              ]
            },
            {
              "id": "dash-settings-btn",
              "type": "frame", "width": "fit_content", "height": 32,
              "stroke": { "align": "inside", "thickness": 1, "fill": "$color.border" },
              "layout": "horizontal", "alignItems": "center", "gap": 6,
              "padding": [0, 12, 0, 12],
              "children": [
                { "id": "dash-settings-icon", "type": "icon_font", "iconFontFamily": "lucide", "iconFontName": "settings", "width": 14, "height": 14, "fill": "$color.textSecondary" },
                { "id": "dash-settings-text", "type": "text", "content": "Settings", "fill": "$color.textSecondary", "fontFamily": "$font.mono", "fontSize": 12 }
              ]
            }
          ]
        },

        {
          "id": "dash-body",
          "name": "Dashboard Content",
          "type": "frame",
          "width": "fill_container", "height": "fit_content",
          "fill": "$color.bg",
          "layout": "horizontal", "gap": 24,
          "padding": [32, 80, 48, 80],
          "children": [

            {
              "id": "dash-main",
              "name": "Main Content Column",
              "type": "frame",
              "width": "fill_container", "height": "fit_content",
              "layout": "vertical", "gap": 24,
              "children": [

                {
                  "id": "dash-active-section",
                  "type": "frame", "width": "fill_container", "height": "fit_content",
                  "layout": "vertical", "gap": 16,
                  "children": [
                    { "id": "dash-active-title", "type": "text", "content": "Your active hackathons", "fill": "$color.text", "fontFamily": "$font.mono", "fontSize": 16, "fontWeight": "700" },
                    {
                      "id": "dash-active-card",
                      "type": "frame", "width": "fill_container", "height": "fit_content",
                      "fill": "$color.surface",
                      "stroke": { "align": "inside", "thickness": 1, "fill": "$color.border" },
                      "layout": "horizontal", "gap": 20, "padding": 20, "alignItems": "center",
                      "children": [
                        {
                          "id": "dash-active-thumb",
                          "type": "rectangle", "width": 64, "height": 64,
                          "fill": { "type": "gradient", "gradientType": "linear", "rotation": 135, "colors": [ { "color": "#3D8A2E", "position": 0 }, { "color": "#1A2E14", "position": 1 } ] }
                        },
                        {
                          "id": "dash-active-info",
                          "type": "frame", "width": "fill_container", "height": "fit_content",
                          "layout": "vertical", "gap": 6,
                          "children": [
                            {
                              "id": "dash-active-name-row",
                              "type": "frame", "width": "fit_content", "height": "fit_content",
                              "layout": "horizontal", "gap": 12, "alignItems": "center",
                              "children": [
                                { "id": "dash-active-name", "type": "text", "content": "ORD Hackathon 2026", "fill": "$color.text", "fontFamily": "$font.mono", "fontSize": 15, "fontWeight": "600" },
                                {
                                  "id": "dash-active-badge",
                                  "type": "frame", "width": "fit_content", "height": 20,
                                  "fill": "$color.primaryMuted",
                                  "stroke": { "align": "inside", "thickness": 1, "fill": "$color.primaryDark" },
                                  "layout": "horizontal", "justifyContent": "center", "alignItems": "center",
                                  "padding": [2, 8, 2, 8],
                                  "children": [
                                    { "id": "dash-active-badge-text", "type": "text", "content": "Project Proposals", "fill": "$color.primary", "fontFamily": "$font.mono", "fontSize": 10, "fontWeight": "600" }
                                  ]
                                }
                              ]
                            },
                            { "id": "dash-active-meta", "type": "text", "content": "24 – 25 Oct 2026  ·  ETH Zurich  ·  Team: DataFlow (4 members)", "fill": "$color.textSecondary", "fontFamily": "$font.mono", "fontSize": 12 },
                            {
                              "id": "dash-active-progress",
                              "type": "frame", "width": "fill_container", "height": 4,
                              "fill": "$color.surfaceRaised",
                              "children": [
                                { "id": "dash-active-progress-fill", "type": "rectangle", "width": 200, "height": 4, "fill": "$color.primary" }
                              ]
                            }
                          ]
                        },
                        {
                          "id": "dash-active-go",
                          "type": "icon_font", "iconFontFamily": "lucide", "iconFontName": "arrow-right", "width": 16, "height": 16, "fill": "$color.textMuted"
                        }
                      ]
                    }
                  ]
                },

                {
                  "id": "dash-past-section",
                  "type": "frame", "width": "fill_container", "height": "fit_content",
                  "layout": "vertical", "gap": 16,
                  "children": [
                    { "id": "dash-past-title", "type": "text", "content": "Past participation", "fill": "$color.text", "fontFamily": "$font.mono", "fontSize": 16, "fontWeight": "700" },
                    {
                      "id": "dash-past-row-1",
                      "type": "frame", "width": "fill_container", "height": 56,
                      "fill": "$color.surface",
                      "stroke": { "align": "inside", "thickness": 1, "fill": "$color.border" },
                      "layout": "horizontal", "gap": 16, "padding": [0, 16, 0, 16], "alignItems": "center",
                      "children": [
                        { "id": "dpr1-thumb", "type": "rectangle", "width": 36, "height": 36, "fill": { "type": "gradient", "gradientType": "linear", "rotation": 135, "colors": [ { "color": "#5A4D8A", "position": 0 }, { "color": "#2A2040", "position": 1 } ] } },
                        {
                          "id": "dpr1-info",
                          "type": "frame", "width": "fill_container", "height": "fit_content",
                          "layout": "vertical", "gap": 2,
                          "children": [
                            { "id": "dpr1-name", "type": "text", "content": "GenAI Hackathon 2025", "fill": "$color.text", "fontFamily": "$font.mono", "fontSize": 13, "fontWeight": "500" },
                            { "id": "dpr1-meta", "type": "text", "content": "Nov 2025  ·  Team BioViz  ·  2nd place", "fill": "$color.textMuted", "fontFamily": "$font.mono", "fontSize": 11 }
                          ]
                        },
                        { "id": "dpr1-arrow", "type": "icon_font", "iconFontFamily": "lucide", "iconFontName": "chevron-right", "width": 14, "height": 14, "fill": "$color.textMuted" }
                      ]
                    },
                    {
                      "id": "dash-past-row-2",
                      "type": "frame", "width": "fill_container", "height": 56,
                      "fill": "$color.surface",
                      "stroke": { "align": "inside", "thickness": 1, "fill": "$color.border" },
                      "layout": "horizontal", "gap": 16, "padding": [0, 16, 0, 16], "alignItems": "center",
                      "children": [
                        { "id": "dpr2-thumb", "type": "rectangle", "width": 36, "height": 36, "fill": { "type": "gradient", "gradientType": "linear", "rotation": 135, "colors": [ { "color": "#3D8A2E", "position": 0 }, { "color": "#1A2E14", "position": 1 } ] } },
                        {
                          "id": "dpr2-info",
                          "type": "frame", "width": "fill_container", "height": "fit_content",
                          "layout": "vertical", "gap": 2,
                          "children": [
                            { "id": "dpr2-name", "type": "text", "content": "ORD Hackathon 2025", "fill": "$color.text", "fontFamily": "$font.mono", "fontSize": 13, "fontWeight": "500" },
                            { "id": "dpr2-meta", "type": "text", "content": "Oct 2025  ·  Team DataFlow  ·  1st place", "fill": "$color.textMuted", "fontFamily": "$font.mono", "fontSize": 11 }
                          ]
                        },
                        { "id": "dpr2-arrow", "type": "icon_font", "iconFontFamily": "lucide", "iconFontName": "chevron-right", "width": 14, "height": 14, "fill": "$color.textMuted" }
                      ]
                    }
                  ]
                }
              ]
            },

            {
              "id": "dash-sidebar",
              "name": "Sidebar Column",
              "type": "frame",
              "width": 320, "height": "fit_content",
              "layout": "vertical", "gap": 24,
              "children": [

                {
                  "id": "dash-notifs",
                  "type": "frame", "width": "fill_container", "height": "fit_content",
                  "fill": "$color.surface",
                  "stroke": { "align": "inside", "thickness": 1, "fill": "$color.border" },
                  "layout": "vertical", "gap": 0,
                  "children": [
                    {
                      "id": "dash-notifs-header",
                      "type": "frame", "width": "fill_container", "height": 40,
                      "layout": "horizontal", "alignItems": "center", "justifyContent": "space_between",
                      "padding": [0, 16, 0, 16],
                      "stroke": { "align": "inside", "thickness": { "bottom": 1 }, "fill": "$color.border" },
                      "children": [
                        { "id": "dash-notifs-title", "type": "text", "content": "Notifications", "fill": "$color.text", "fontFamily": "$font.mono", "fontSize": 13, "fontWeight": "600" },
                        {
                          "id": "dash-notifs-count",
                          "type": "frame", "width": 20, "height": 20,
                          "fill": "$color.primary",
                          "layout": "horizontal", "justifyContent": "center", "alignItems": "center",
                          "children": [
                            { "id": "dash-notifs-count-text", "type": "text", "content": "2", "fill": "$color.onPrimary", "fontFamily": "$font.mono", "fontSize": 11, "fontWeight": "700" }
                          ]
                        }
                      ]
                    },
                    {
                      "id": "dash-notif-1",
                      "type": "frame", "width": "fill_container", "height": "fit_content",
                      "layout": "horizontal", "gap": 12, "padding": 16, "alignItems": "start",
                      "stroke": { "align": "inside", "thickness": { "bottom": 1 }, "fill": "$color.border" },
                      "children": [
                        { "id": "dash-n1-icon", "type": "icon_font", "iconFontFamily": "lucide", "iconFontName": "bell", "width": 14, "height": 14, "fill": "$color.primary" },
                        {
                          "id": "dash-n1-content",
                          "type": "frame", "width": "fill_container", "height": "fit_content",
                          "layout": "vertical", "gap": 4,
                          "children": [
                            { "id": "dash-n1-text", "type": "text", "content": "Project proposals are due in 5 days for ORD Hackathon 2026.", "fill": "$color.text", "fontFamily": "$font.mono", "fontSize": 12, "lineHeight": 1.4, "textGrowth": "fixed-width", "width": 240 },
                            { "id": "dash-n1-time", "type": "text", "content": "2 hours ago", "fill": "$color.textMuted", "fontFamily": "$font.mono", "fontSize": 10 }
                          ]
                        }
                      ]
                    },
                    {
                      "id": "dash-notif-2",
                      "type": "frame", "width": "fill_container", "height": "fit_content",
                      "layout": "horizontal", "gap": 12, "padding": 16, "alignItems": "start",
                      "children": [
                        { "id": "dash-n2-icon", "type": "icon_font", "iconFontFamily": "lucide", "iconFontName": "user-plus", "width": 14, "height": 14, "fill": "$color.secondary" },
                        {
                          "id": "dash-n2-content",
                          "type": "frame", "width": "fill_container", "height": "fit_content",
                          "layout": "vertical", "gap": 4,
                          "children": [
                            { "id": "dash-n2-text", "type": "text", "content": "You were added to Team DataFlow by Carlos.", "fill": "$color.text", "fontFamily": "$font.mono", "fontSize": 12, "lineHeight": 1.4, "textGrowth": "fixed-width", "width": 240 },
                            { "id": "dash-n2-time", "type": "text", "content": "1 day ago", "fill": "$color.textMuted", "fontFamily": "$font.mono", "fontSize": 10 }
                          ]
                        }
                      ]
                    }
                  ]
                },

                {
                  "id": "dash-quick-links",
                  "type": "frame", "width": "fill_container", "height": "fit_content",
                  "fill": "$color.surface",
                  "stroke": { "align": "inside", "thickness": 1, "fill": "$color.border" },
                  "layout": "vertical", "gap": 0,
                  "children": [
                    {
                      "id": "dash-ql-header",
                      "type": "frame", "width": "fill_container", "height": 40,
                      "layout": "horizontal", "alignItems": "center",
                      "padding": [0, 16, 0, 16],
                      "stroke": { "align": "inside", "thickness": { "bottom": 1 }, "fill": "$color.border" },
                      "children": [
                        { "id": "dash-ql-title", "type": "text", "content": "Quick Links", "fill": "$color.text", "fontFamily": "$font.mono", "fontSize": 13, "fontWeight": "600" }
                      ]
                    },
                    {
                      "id": "dash-ql-1",
                      "type": "frame", "width": "fill_container", "height": 36,
                      "layout": "horizontal", "gap": 8, "alignItems": "center",
                      "padding": [0, 16, 0, 16],
                      "children": [
                        { "id": "dash-ql-1-icon", "type": "icon_font", "iconFontFamily": "lucide", "iconFontName": "user", "width": 14, "height": 14, "fill": "$color.textMuted" },
                        { "id": "dash-ql-1-text", "type": "text", "content": "Edit Profile", "fill": "$color.textSecondary", "fontFamily": "$font.mono", "fontSize": 12 }
                      ]
                    },
                    {
                      "id": "dash-ql-2",
                      "type": "frame", "width": "fill_container", "height": 36,
                      "layout": "horizontal", "gap": 8, "alignItems": "center",
                      "padding": [0, 16, 0, 16],
                      "children": [
                        { "id": "dash-ql-2-icon", "type": "icon_font", "iconFontFamily": "lucide", "iconFontName": "file-text", "width": 14, "height": 14, "fill": "$color.textMuted" },
                        { "id": "dash-ql-2-text", "type": "text", "content": "My Submissions", "fill": "$color.textSecondary", "fontFamily": "$font.mono", "fontSize": 12 }
                      ]
                    },
                    {
                      "id": "dash-ql-3",
                      "type": "frame", "width": "fill_container", "height": 36,
                      "layout": "horizontal", "gap": 8, "alignItems": "center",
                      "padding": [0, 16, 0, 16],
                      "children": [
                        { "id": "dash-ql-3-icon", "type": "icon_font", "iconFontFamily": "lucide", "iconFontName": "settings", "width": 14, "height": 14, "fill": "$color.textMuted" },
                        { "id": "dash-ql-3-text", "type": "text", "content": "Account Settings", "fill": "$color.textSecondary", "fontFamily": "$font.mono", "fontSize": 12 }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },

        { "id": "dash-footer", "type": "ref", "ref": "footer-main" }
      ]
    },

    {
      "id": "hackathon-page",
      "name": "Hackathon Detail Page — /hackathon/[slug] (Desktop 1440px)",
      "context": "Public hackathon detail page. Composed of modular sections that organizers can toggle on/off. This wireframe shows all 7 section types from the Confluence requirements, using ORD Hackathon 2026 as sample content. Route: /hackathon/[slug]",
      "type": "frame",
      "x": 3200, "y": 0,
      "width": 1440,
      "height": "fit_content",
      "fill": "$color.bg",
      "layout": "vertical",
      "clip": true,
      "children": [

        { "id": "hp-nav", "type": "ref", "ref": "nav-bar" },

        {
          "id": "hp-hero",
          "name": "Section 1: Hero",
          "context": "Confluence req: Title (string), Dates (string), Venue (string), Hackathon main photo (string, url). Full-width hero with theme-aware bg and text.",
          "type": "frame",
          "width": "fill_container", "height": 400,
          "fill": "$color.primaryMuted",
          "layout": "vertical", "justifyContent": "end", "gap": 16,
          "padding": [0, 80, 48, 80],
          "children": [
            {
              "id": "hp-hero-breadcrumb",
              "type": "frame", "width": "fit_content", "height": "fit_content",
              "layout": "horizontal", "gap": 6, "alignItems": "center",
              "children": [
                { "id": "hp-bc-home", "type": "text", "content": "Hackathons", "fill": "$color.textMuted", "fontFamily": "$font.mono", "fontSize": 12 },
                { "id": "hp-bc-sep", "type": "text", "content": "/", "fill": "$color.textMuted", "fontFamily": "$font.mono", "fontSize": 12 },
                { "id": "hp-bc-current", "type": "text", "content": "ORD Hackathon 2026", "fill": "$color.textSecondary", "fontFamily": "$font.mono", "fontSize": 12 }
              ]
            },
            {
              "id": "hp-hero-badge",
              "type": "frame", "width": "fit_content", "height": 24,
              "fill": "$color.primaryMuted",
              "stroke": { "align": "inside", "thickness": 1, "fill": "$color.primaryDark" },
              "layout": "horizontal", "justifyContent": "center", "alignItems": "center",
              "padding": [3, 12, 3, 12], "gap": 6,
              "children": [
                { "id": "hp-hero-badge-dot", "type": "ellipse", "width": 6, "height": 6, "fill": "$color.primary" },
                { "id": "hp-hero-badge-text", "type": "text", "content": "Registration Open", "fill": "$color.primary", "fontFamily": "$font.mono", "fontSize": 11, "fontWeight": "600" }
              ]
            },
            {
              "id": "hp-hero-title",
              "type": "text",
              "content": "Open Research Data\nHackathon 2026",
              "fill": "$color.text",
              "fontFamily": "$font.mono", "fontSize": 44, "fontWeight": "700", "lineHeight": 1.1,
              "textGrowth": "fixed-width", "width": 700
            },
            {
              "id": "hp-hero-meta",
              "type": "frame", "width": "fit_content", "height": "fit_content",
              "layout": "horizontal", "gap": 24, "alignItems": "center",
              "children": [
                {
                  "id": "hp-hero-dates",
                  "type": "frame", "width": "fit_content", "height": "fit_content",
                  "layout": "horizontal", "gap": 8, "alignItems": "center",
                  "children": [
                    { "id": "hp-hd-icon", "type": "icon_font", "iconFontFamily": "lucide", "iconFontName": "calendar", "width": 16, "height": 16, "fill": "$color.primary" },
                    { "id": "hp-hd-text", "type": "text", "content": "24 – 25 October 2026", "fill": "$color.textSecondary", "fontFamily": "$font.mono", "fontSize": 15 }
                  ]
                },
                {
                  "id": "hp-hero-venue",
                  "type": "frame", "width": "fit_content", "height": "fit_content",
                  "layout": "horizontal", "gap": 8, "alignItems": "center",
                  "children": [
                    { "id": "hp-hv-icon", "type": "icon_font", "iconFontFamily": "lucide", "iconFontName": "map-pin", "width": 16, "height": 16, "fill": "$color.primary" },
                    { "id": "hp-hv-text", "type": "text", "content": "ETH Zurich, Zurich", "fill": "$color.textSecondary", "fontFamily": "$font.mono", "fontSize": 15 }
                  ]
                },
                {
                  "id": "hp-hero-capacity",
                  "type": "frame", "width": "fit_content", "height": "fit_content",
                  "layout": "horizontal", "gap": 8, "alignItems": "center",
                  "children": [
                    { "id": "hp-hc-icon", "type": "icon_font", "iconFontFamily": "lucide", "iconFontName": "users", "width": 16, "height": 16, "fill": "$color.primary" },
                    { "id": "hp-hc-text", "type": "text", "content": "42 / 100 registered", "fill": "$color.textSecondary", "fontFamily": "$font.mono", "fontSize": 15 }
                  ]
                }
              ]
            }
          ]
        },

        {
          "id": "hp-organizers",
          "name": "Section 2: Organizers",
          "context": "Confluence req: Description (string), Logos (List of picture URL). Horizontal layout — description text on the left, organizer logos on the right.",
          "type": "frame",
          "width": "fill_container", "height": "fit_content",
          "fill": "$color.surface",
          "layout": "horizontal", "gap": 48, "alignItems": "center",
          "padding": [40, 80, 40, 80],
          "stroke": { "align": "inside", "thickness": { "bottom": 1 }, "fill": "$color.border" },
          "children": [
            {
              "id": "hp-org-text",
              "type": "frame", "width": "fill_container", "height": "fit_content",
              "layout": "vertical", "gap": 12,
              "children": [
                { "id": "hp-org-label", "type": "text", "content": "ORGANIZED BY", "fill": "$color.textMuted", "fontFamily": "$font.mono", "fontSize": 11, "fontWeight": "700", "letterSpacing": 2 },
                { "id": "hp-org-desc", "type": "text", "content": "Co-organized by the Swiss Data Science Center (SDSC) and ETH Zurich Library, this hackathon brings together researchers, developers, and data stewards to build tools that make research data more accessible and reusable.", "fill": "$color.textSecondary", "fontFamily": "$font.mono", "fontSize": 13, "lineHeight": 1.6, "textGrowth": "fixed-width", "width": 720 }
              ]
            },
            {
              "id": "hp-org-logos",
              "type": "frame", "width": "fit_content", "height": "fit_content",
              "layout": "horizontal", "gap": 24, "alignItems": "center",
              "children": [
                {
                  "id": "hp-org-logo-1",
                  "type": "frame", "width": "fit_content", "height": "fit_content",
                  "layout": "vertical", "gap": 6, "alignItems": "center",
                  "children": [
                    { "id": "hp-ol1-img", "type": "rectangle", "width": 56, "height": 56, "fill": "$color.surfaceRaised", "stroke": { "align": "inside", "thickness": 1, "fill": "$color.border" } },
                    { "id": "hp-ol1-name", "type": "text", "content": "SDSC", "fill": "$color.textMuted", "fontFamily": "$font.mono", "fontSize": 11 }
                  ]
                },
                {
                  "id": "hp-org-logo-2",
                  "type": "frame", "width": "fit_content", "height": "fit_content",
                  "layout": "vertical", "gap": 6, "alignItems": "center",
                  "children": [
                    { "id": "hp-ol2-img", "type": "rectangle", "width": 56, "height": 56, "fill": "$color.surfaceRaised", "stroke": { "align": "inside", "thickness": 1, "fill": "$color.border" } },
                    { "id": "hp-ol2-name", "type": "text", "content": "ETH Zurich", "fill": "$color.textMuted", "fontFamily": "$font.mono", "fontSize": 11 }
                  ]
                }
              ]
            }
          ]
        },

        {
          "id": "hp-markdown",
          "name": "Section 3: Markdown Content",
          "context": "Confluence req: Markdown formatted text — bold, lists, links, and embedded pictures. Rendered as rich text in a centered content column. This section can appear multiple times with different content.",
          "type": "frame",
          "width": "fill_container", "height": "fit_content",
          "fill": "$color.bg",
          "layout": "vertical", "gap": 0,
          "padding": [48, 80, 48, 80],
          "children": [
            {
              "id": "hp-md-content",
              "type": "frame", "width": 860, "height": "fit_content",
              "layout": "vertical", "gap": 20,
              "children": [
                { "id": "hp-md-h2", "type": "text", "content": "About the Hackathon", "fill": "$color.text", "fontFamily": "$font.mono", "fontSize": 24, "fontWeight": "700" },
                { "id": "hp-md-p1", "type": "text", "content": "The Open Research Data Hackathon is a two-day event focused on building practical tools and workflows that advance FAIR (Findable, Accessible, Interoperable, Reusable) data practices in Swiss research.", "fill": "$color.textSecondary", "fontFamily": "$font.mono", "fontSize": 14, "lineHeight": 1.7, "textGrowth": "fixed-width", "width": 860 },
                { "id": "hp-md-h3", "type": "text", "content": "What to expect", "fill": "$color.text", "fontFamily": "$font.mono", "fontSize": 18, "fontWeight": "600" },
                {
                  "id": "hp-md-list",
                  "type": "frame", "width": "fit_content", "height": "fit_content",
                  "layout": "vertical", "gap": 8, "padding": [0, 0, 0, 16],
                  "children": [
                    { "id": "hp-md-li1", "type": "text", "content": "·  Day 1: Keynote talks, team formation, project kickoff, and evening apero", "fill": "$color.textSecondary", "fontFamily": "$font.mono", "fontSize": 14, "lineHeight": 1.5, "textGrowth": "fixed-width", "width": 820 },
                    { "id": "hp-md-li2", "type": "text", "content": "·  Day 2: Intensive hacking sessions, project presentations, voting, and awards", "fill": "$color.textSecondary", "fontFamily": "$font.mono", "fontSize": 14, "lineHeight": 1.5, "textGrowth": "fixed-width", "width": 820 }
                  ]
                },
                { "id": "hp-md-h3b", "type": "text", "content": "Who should participate", "fill": "$color.text", "fontFamily": "$font.mono", "fontSize": 18, "fontWeight": "600" },
                {
                  "id": "hp-md-list2",
                  "type": "frame", "width": "fit_content", "height": "fit_content",
                  "layout": "vertical", "gap": 8, "padding": [0, 0, 0, 16],
                  "children": [
                    { "id": "hp-md-li3", "type": "text", "content": "·  Researchers working with open data", "fill": "$color.textSecondary", "fontFamily": "$font.mono", "fontSize": 14 },
                    { "id": "hp-md-li4", "type": "text", "content": "·  Software developers interested in research infrastructure", "fill": "$color.textSecondary", "fontFamily": "$font.mono", "fontSize": 14 },
                    { "id": "hp-md-li5", "type": "text", "content": "·  Data stewards and librarians", "fill": "$color.textSecondary", "fontFamily": "$font.mono", "fontSize": 14 },
                    { "id": "hp-md-li6", "type": "text", "content": "·  Students in data science, CS, or related fields", "fill": "$color.textSecondary", "fontFamily": "$font.mono", "fontSize": 14 }
                  ]
                }
              ]
            }
          ]
        },

        {
          "id": "hp-events",
          "name": "Section 4: Support Events (Webinars)",
          "context": "Confluence req: Titles (list of webinars), Speakers / Companies logos (list of pictures), Link to section with more information. Shown as a row of event cards.",
          "type": "frame",
          "width": "fill_container", "height": "fit_content",
          "fill": "$color.surface",
          "layout": "vertical", "gap": 24,
          "padding": [48, 80, 48, 80],
