    {
      "id": "hackathon-loggedin",
      "name": "Hackathon Page — Logged In & Participating (Desktop 1440px)",
      "context": "Logged-in participant view of a hackathon. Uses our modern single-column centered layout (not the old 3-column site). Functional requirements extracted from Figma reference (eUBPuQj0KlWAzIfKEgqpHY): hackathon sub-page navigation, phase-aware user actions, participation status, team/project management, admin tools. User 'Sabine' is participating in ORD Hackathon 2026, currently in 'Proposals' phase, on team 'Bishorn'.",
      "type": "frame",
