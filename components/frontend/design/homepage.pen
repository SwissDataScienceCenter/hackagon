              "children": [
                { "id": "tm-card-1", "type": "ref", "ref": "team-card" },
                { "id": "tm-card-2", "type": "ref", "ref": "team-card", "descendants": { "tc-name": { "content": "14. Dufourspitze" }, "tc-desc": { "content": "Embedding of Pharmacokinetic and Pharmacodynamic equations into symbolic representation and alignment with their textual description" } } },
                { "id": "tm-card-3", "type": "ref", "ref": "team-card", "descendants": { "tc-name": { "content": "12. Matterhorn" }, "tc-desc": { "content": "A platform for semantic navigation and visualization of Neo4J graphs using natural language queries and knowledge graph exploration" } } }
