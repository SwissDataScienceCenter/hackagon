                          ]
                        }
                      ]
                    },

                    {
                      "id": "hli-webinars-section",
                      "name": "Webinars",
                      "context": "FUNCTIONALITY: View and access support events (webinars). From Figma: speakers with avatars, webinar link. This is the same 'Support Events' section from the public page but with richer detail.",
