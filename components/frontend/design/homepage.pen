            {
              "id": "hli-main-body",
              "name": "Main Content Area",
              "type": "frame",
              "width": 1280, "height": "fit_content",
              "layout": "horizontal", "gap": 24,
              "padding": [24, 0, 24, 0],
              "children": [

                {
                  "id": "hli-main-col",
                  "name": "Primary Column",
                  "type": "frame",
                  "width": "fill_container", "height": "fit_content",
                  "layout": "vertical", "gap": 24,
                  "children": [

                    {
                      "id": "hli-participation-card",
                      "name": "Your Participation Status",
                      "context": "FUNCTIONALITY: Show user's participation context. From data model: Participant (hackathon_id, user_id, is_waiting), Team (name, description, category_id, status), TeamParticipant (team_id, user_id, role). Shows team, role, next action for current phase.",
                      "type": "frame",
                      "width": "fill_container", "height": "fit_content",
                      "fill": "$color.primaryMuted",
                      "stroke": { "align": "inside", "thickness": 1, "fill": "$color.primaryDark" },
                      "layout": "vertical", "gap": 16,
                      "padding": 20,
                      "children": [
                        {
                          "id": "hli-ps-header",
                          "type": "frame", "width": "fill_container", "height": "fit_content",
                          "layout": "horizontal", "justifyContent": "space-between", "alignItems": "center",
                          "children": [
                            { "id": "hli-ps-title", "type": "text", "content": "Your Participation", "fill": "$color.text", "fontFamily": "$font.mono", "fontSize": 15, "fontWeight": "700" },
                            {
                              "id": "hli-ps-badge",
                              "type": "frame", "width": "fit_content", "height": 24,
                              "fill": "$color.primary",
                              "layout": "horizontal", "justifyContent": "center", "alignItems": "center",
                              "padding": [0, 10, 0, 10],
                              "children": [
                                { "id": "hli-ps-badge-text", "type": "text", "content": "REGISTERED", "fill": "$color.onPrimary", "fontFamily": "$font.mono", "fontSize": 10, "fontWeight": "700" }
                              ]
                            }
                          ]
                        },
                        {
                          "id": "hli-ps-details",
                          "type": "frame", "width": "fill_container", "height": "fit_content",
                          "layout": "horizontal", "gap": 32,
                          "children": [
                            {
                              "id": "hli-ps-team",
                              "name": "Team Info",
                              "context": "FUNCTIONALITY: View team assignment. Team has: name, description, category, status, visibility. TeamParticipant has role (owner, member).",
                              "type": "frame", "width": "fill_container", "height": "fit_content",
                              "layout": "vertical", "gap": 6,
                              "children": [
                                { "id": "hli-ps-team-label", "type": "text", "content": "TEAM", "fill": "$color.textMuted", "fontFamily": "$font.mono", "fontSize": 10, "fontWeight": "700", "letterSpacing": 1 },
                                { "id": "hli-ps-team-name", "type": "text", "content": "Bishorn", "fill": "$color.text", "fontFamily": "$font.mono", "fontSize": 14, "fontWeight": "600" },
                                {
                                  "id": "hli-ps-team-members",
                                  "type": "frame", "width": "fit_content", "height": "fit_content",
                                  "layout": "horizontal", "gap": -6,
                                  "children": [
                                    { "id": "hli-ps-m1", "type": "ellipse", "width": 24, "height": 24, "fill": "$color.surfaceRaised", "stroke": { "align": "outside", "thickness": 2, "fill": "$color.primaryMuted" } },
                                    { "id": "hli-ps-m2", "type": "ellipse", "width": 24, "height": 24, "fill": "$color.surfaceRaised", "stroke": { "align": "outside", "thickness": 2, "fill": "$color.primaryMuted" } },
                                    { "id": "hli-ps-m3", "type": "ellipse", "width": 24, "height": 24, "fill": "$color.surfaceRaised", "stroke": { "align": "outside", "thickness": 2, "fill": "$color.primaryMuted" } }
                                  ]
                                },
                                { "id": "hli-ps-team-role", "type": "text", "content": "Your role: Member", "fill": "$color.textMuted", "fontFamily": "$font.mono", "fontSize": 11 }
                              ]
                            },
                            {
                              "id": "hli-ps-project",
                              "name": "Project Info",
                              "context": "FUNCTIONALITY: View project proposal. From Figma: users can propose projects, choose preferences, submit. Linked to Submission (team_id, hackathon_id, status).",
                              "type": "frame", "width": "fill_container", "height": "fit_content",
                              "layout": "vertical", "gap": 6,
                              "children": [
                                { "id": "hli-ps-proj-label", "type": "text", "content": "PROJECT", "fill": "$color.textMuted", "fontFamily": "$font.mono", "fontSize": 10, "fontWeight": "700", "letterSpacing": 1 },
                                { "id": "hli-ps-proj-name", "type": "text", "content": "SoDeDo: Replicated Dataset for ML", "fill": "$color.text", "fontFamily": "$font.mono", "fontSize": 14, "fontWeight": "600" },
                                { "id": "hli-ps-proj-track", "type": "text", "content": "Track: Data Science", "fill": "$color.primary", "fontFamily": "$font.mono", "fontSize": 11 },
                                { "id": "hli-ps-proj-status", "type": "text", "content": "Status: Proposal submitted", "fill": "$color.textMuted", "fontFamily": "$font.mono", "fontSize": 11 }
                              ]
                            },
                            {
                              "id": "hli-ps-next-action",
                              "name": "Next Action (phase-aware)",
                              "context": "FUNCTIONALITY: Phase-aware CTA. Changes per phase. From Figma: Propose project → Choose preferences → Submit → Vote. Currently in Proposals phase, so next action is 'Choose preferences'.",
                              "type": "frame", "width": "fit_content", "height": "fit_content",
                              "layout": "vertical", "gap": 8, "alignItems": "flex-end",
                              "children": [
                                { "id": "hli-ps-next-label", "type": "text", "content": "NEXT STEP", "fill": "$color.textMuted", "fontFamily": "$font.mono", "fontSize": 10, "fontWeight": "700", "letterSpacing": 1 },
                                {
                                  "id": "hli-ps-next-btn",
                                  "type": "frame", "width": 200, "height": 36,
                                  "fill": "$color.primary",
                                  "layout": "horizontal", "justifyContent": "center", "alignItems": "center", "gap": 6,
                                  "children": [
                                    { "id": "hli-ps-next-icon", "type": "icon_font", "iconFontFamily": "lucide", "iconFontName": "arrow-right", "width": 14, "height": 14, "fill": "$color.onPrimary" },
                                    { "id": "hli-ps-next-text", "type": "text", "content": "Set Preferences", "fill": "$color.onPrimary", "fontFamily": "$font.mono", "fontSize": 12, "fontWeight": "600" }
                                  ]
                                },
                                { "id": "hli-ps-next-hint", "type": "text", "content": "Closes in 12 days", "fill": "$color.accent", "fontFamily": "$font.mono", "fontSize": 11 }
                              ]
                            }
                          ]
                        }
                      ]
                    },

                    {
                      "id": "hli-about-section",
                      "name": "About (markdown section — same as public)",
                      "type": "frame",
                      "width": "fill_container", "height": "fit_content",
                      "fill": "$color.surface",
                      "stroke": { "align": "inside", "thickness": 1, "fill": "$color.border" },
                      "layout": "vertical", "gap": 12,
                      "padding": 20,
                      "children": [
                        { "id": "hli-about-h2", "type": "text", "content": "About", "fill": "$color.text", "fontFamily": "$font.mono", "fontSize": 16, "fontWeight": "700" },
                        { "id": "hli-about-p", "type": "text", "content": "Explore the potential and impact of Open Research Data on the sciences! Co-organized by the Swiss Data Science Center and EPFL Open Science, this event brings together professionals from academia, industry, and the public sector.", "fill": "$color.textSecondary", "fontFamily": "$font.mono", "fontSize": 13, "lineHeight": 1.6, "textGrowth": "fixed-width", "width": 640 }
                      ]
                    },

                    {
                      "id": "hli-proposals-section",
                      "name": "Project Proposals with Tracks",
                      "context": "FUNCTIONALITY: View and propose projects. From data model: Category (id, hackathon_id, name) = tracks. From Figma: two tracks (Data Science, Research Data Infrastructure). Users can 'Propose a project' and 'More Info'. Lists proposals with title, description, image, 'More Info' button.",
                      "type": "frame",
                      "width": "fill_container", "height": "fit_content",
                      "fill": "$color.surface",
                      "stroke": { "align": "inside", "thickness": 1, "fill": "$color.border" },
                      "layout": "vertical", "gap": 16,
                      "padding": 20,
                      "children": [
                        {
                          "id": "hli-prop-head",
                          "type": "frame", "width": "fill_container", "height": "fit_content",
                          "layout": "horizontal", "justifyContent": "space-between", "alignItems": "center",
                          "children": [
                            { "id": "hli-prop-title", "type": "text", "content": "Project Proposals", "fill": "$color.text", "fontFamily": "$font.mono", "fontSize": 16, "fontWeight": "700" },
