    {
      "type": "frame",
      "id": "proposal-card-mobile",
      "x": 7200,
      "y": 160,
      "name": "Component: Proposal Card (Mobile)",
      "context": "Narrow: vertical stack. Row 1 = avatar + title block; description full width; full-width More Info. Same tokens as proposal-card. Max width 358 (390 - 2*gutter).",
      "reusable": true,
      "width": 358,
      "fill": "$color.surface",
      "stroke": {
        "align": "inside",
