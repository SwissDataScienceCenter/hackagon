                            { "id": "hli-ul-about", "type": "ref", "ref": "hli-al", "descendants": { "al-icon": { "iconFontName": "building" }, "al-text": { "content": "About SDSC" } } },
                            { "id": "hli-ul-contact", "type": "ref", "ref": "hli-al", "descendants": { "al-icon": { "iconFontName": "mail" }, "al-text": { "content": "Contact us" } } },
