              "id": "trending-list",
              "width": "fill_container",
              "layout": "vertical",
              "children": [
                {
                  "type": "frame",
                  "id": "trending-row",
                  "name": "Trending Row",
                  "reusable": true,
                  "width": "fill_container",
                  "height": 72,
                  "stroke": {
                    "align": "inside",
                    "thickness": {
                      "bottom": 1
                    },
                    "fill": "$color.border"
