                    "hl1-message": { "content": "Collaborate with researchers, engineers, and data stewards from across Switzerland." }
                  }
                },
                {
                  "id": "hp-hl-block-3",
                  "type": "ref", "ref": "hp-hl-block-1",
                  "descendants": {
                    "hl1-image": { "fill": { "type": "gradient", "gradientType": "linear", "rotation": 150, "colors": [ { "color": "#5A4A2E", "position": 0 }, { "color": "#2E2A1A", "position": 1 } ] } },
