                  "width": 320, "height": "fit_content",
                  "layout": "vertical", "gap": 16,
                  "children": [

                    {
                      "id": "hli-quick-actions",
                      "name": "Phase-Aware Quick Actions",
                      "context": "FUNCTIONALITY: From Figma right sidebar — personal options that change per phase. Registration: 'Check profile', 'User settings'. Proposals: 'Propose a project', 'Choose preferences'. Teams: 'Send submission'. Post-hack: 'Vote for best project'. All phases: profile + settings always visible.",
                      "type": "frame",
