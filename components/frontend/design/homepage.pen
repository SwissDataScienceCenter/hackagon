                    "fill": "$color.border"
                  },
                  "gap": 6,
                  "justifyContent": "center",
                  "alignItems": "center",
                  "children": [
                    {
                      "type": "text",
                      "id": "hero-cta-browse-text",
                      "fill": "$color.text",
                      "content": "Browse Hackathons",
                      "fontFamily": "$font.mono",
                      "fontSize": 14,
