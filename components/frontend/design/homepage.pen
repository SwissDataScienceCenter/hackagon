                      "id": "hli-about-section",
                      "name": "About (markdown section — same as public)",
                      "type": "frame",
                      "width": "fill_container", "height": "fit_content",
                      "fill": "$color.surface",
                      "stroke": { "align": "inside", "thickness": 1, "fill": "$color.border" },
                      "layout": "vertical", "gap": 12,
                      "padding": 20,
                      "children": [
                        { "id": "hli-about-h2", "type": "text", "content": "About", "fill": "$color.text", "fontFamily": "$font.mono", "fontSize": 16, "fontWeight": "700" },
                        { "id": "hli-about-p", "type": "text", "content": "Explore the potential and impact of Open Research Data on the sciences! Co-organized by the Swiss Data Science Center and EPFL Open Science, this event brings together professionals from academia, industry, and the public sector.", "fill": "$color.textSecondary", "fontFamily": "$font.mono", "fontSize": 13, "lineHeight": 1.6, "textGrowth": "fixed-width", "width": 640 }
                      ]
                    },

                    {
                      "id": "hli-proposals-section",
                      "name": "Project Proposals with Tracks",
                      "context": "FUNCTIONALITY: View and propose projects. From data model: Category (id, hackathon_id, name) = tracks. From Figma: two tracks (Data Science, Research Data Infrastructure). Users can 'Propose a project' and 'More Info'. Lists proposals with title, description, image, 'More Info' button.",
                      "type": "frame",
                      "width": "fill_container", "height": "fit_content",
                      "fill": "$color.surface",
                      "stroke": { "align": "inside", "thickness": 1, "fill": "$color.border" },
                      "layout": "vertical", "gap": 16,
                      "padding": 20,
                      "children": [
                        {
                          "id": "hli-prop-head",
                          "type": "frame", "width": "fill_container", "height": "fit_content",
                          "layout": "horizontal", "justifyContent": "space-between", "alignItems": "center",
                          "children": [
                            { "id": "hli-prop-title", "type": "text", "content": "Project Proposals", "fill": "$color.text", "fontFamily": "$font.mono", "fontSize": 16, "fontWeight": "700" },
                            { "id": "hli-prop-count", "type": "text", "content": "16 proposals", "fill": "$color.textMuted", "fontFamily": "$font.mono", "fontSize": 12 }
                          ]
                        },
                        {
                          "id": "hli-track-cards",
                          "type": "frame", "width": "fill_container", "height": "fit_content",
                          "layout": "horizontal", "gap": 12,
                          "children": [
                            {
                              "id": "hli-track-1",
                              "type": "frame", "width": "fill_container", "height": "fit_content",
                              "fill": "$color.primaryMuted",
                              "stroke": { "align": "inside", "thickness": 1, "fill": "$color.primaryDark" },
                              "layout": "vertical", "gap": 4, "padding": 12,
                              "children": [
                                { "id": "hli-t1-name", "type": "text", "content": "DATA SCIENCE", "fill": "$color.primary", "fontFamily": "$font.mono", "fontSize": 11, "fontWeight": "700" },
                                { "id": "hli-t1-count", "type": "text", "content": "9 proposals", "fill": "$color.textMuted", "fontFamily": "$font.mono", "fontSize": 11 }
                              ]
                            },
                            {
                              "id": "hli-track-2",
                              "type": "frame", "width": "fill_container", "height": "fit_content",
                              "fill": "$color.secondaryMuted",
                              "stroke": { "align": "inside", "thickness": 1, "fill": "$color.secondary" },
                              "layout": "vertical", "gap": 4, "padding": 12,
                              "children": [
                                { "id": "hli-t2-name", "type": "text", "content": "RESEARCH DATA INFRA", "fill": "$color.secondary", "fontFamily": "$font.mono", "fontSize": 11, "fontWeight": "700" },
                                { "id": "hli-t2-count", "type": "text", "content": "7 proposals", "fill": "$color.textMuted", "fontFamily": "$font.mono", "fontSize": 11 }
                              ]
                            }
                          ]
                        },
                        {
                          "id": "hli-prop-item",
                          "name": "Proposal List Item (sample)",
                          "type": "frame",
                          "reusable": true,
                          "width": "fill_container", "height": "fit_content",
                          "fill": "$color.bg",
                          "stroke": { "align": "inside", "thickness": 1, "fill": "$color.border" },
                          "layout": "horizontal", "gap": 12, "alignItems": "center",
                          "padding": 12,
                          "children": [
                            { "id": "pi-img", "type": "rectangle", "width": 48, "height": 48, "fill": "$color.surfaceRaised" },
                            {
                              "id": "pi-info",
                              "type": "frame", "width": "fill_container", "height": "fit_content",
                              "layout": "vertical", "gap": 2,
                              "children": [
                                { "id": "pi-num-title", "type": "text", "content": "16. Embedding of Pharmacokinetic Equations", "fill": "$color.text", "fontFamily": "$font.mono", "fontSize": 12, "fontWeight": "600" },
                                { "id": "pi-desc", "type": "text", "content": "In pharma and biotech, ODEs often follow repetitive patterns...", "fill": "$color.textMuted", "fontFamily": "$font.mono", "fontSize": 11 }
                              ]
