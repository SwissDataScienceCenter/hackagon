                      "fill": "$color.surface",
                      "stroke": { "align": "inside", "thickness": 1, "fill": "$color.border" },
                      "layout": "vertical", "gap": 0,
                      "padding": 16,
                      "children": [
                        { "id": "hli-qa-label", "type": "text", "content": "QUICK ACTIONS", "fill": "$color.textMuted", "fontFamily": "$font.mono", "fontSize": 10, "fontWeight": "700", "letterSpacing": 1 },
                        {
                          "id": "hli-qa-btns",
                          "type": "frame", "width": "fill_container", "height": "fit_content",
                          "layout": "vertical", "gap": 6, "padding": [10, 0, 0, 0],
                          "children": [
