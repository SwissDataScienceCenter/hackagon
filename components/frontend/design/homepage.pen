                { "id": "pr-card-2", "type": "ref", "ref": "proposal-card", "descendants": { "prc-title": { "content": "15. Automatic extraction of data from the literature" }, "prc-desc": { "content": "Have you ever been frustrated by having to copy data from the supplementary files of the papers? But the data is distributed across multiple pdf pages or even worse it's embedded as an image!" } } },
                { "id": "pr-card-3", "type": "ref", "ref": "proposal-card", "descendants": { "prc-title": { "content": "14. AgentSim: Browser-Based Agent Modeling with Real Trajectory Data" }, "prc-desc": { "content": "AgentSim is a browser-based application that leverages real-world trajectory data from the PNEUMA project to train agent-based models simulating urban traffic patterns." } } },
                { "id": "pr-card-4", "type": "ref", "ref": "proposal-card", "descendants": { "prc-title": { "content": "13. SoDeDo: A replicated, self-updating software-defined dataset" }, "prc-desc": { "content": "In this project we will explore the technologies for a proof-of-concept data store which simplifies collaborative dataset management for machine learning." } } },
                { "id": "pr-card-5", "type": "ref", "ref": "proposal-card", "descendants": { "prc-title": { "content": "12. A platform for semantic navigation and visualization of Neo4J graphs" }, "prc-desc": { "content": "Neo4J is a graph DB technology with powerful capabilities for graph data science and the exploration of massive knowledge graphs." } } }
              ]
            },
            {
              "id": "pr-pagination",
              "name": "Pagination",
              "type": "frame",
              "width": 960, "height": "fit_content",
              "layout": "horizontal", "justifyContent": "center", "gap": 4,
              "padding": [20, 0, 0, 0],
              "children": [
                {
                  "id": "pr-page-1",
                  "type": "frame", "width": 32, "height": 32,
                  "fill": "$color.primary",
                  "layout": "horizontal", "justifyContent": "center", "alignItems": "center",
                  "children": [
                    { "id": "prp1-text", "type": "text", "content": "1", "fill": "$color.onPrimary", "fontFamily": "$font.mono", "fontSize": 12, "fontWeight": "600" }
                  ]
                },
                {
                  "id": "pr-page-2",
                  "type": "frame", "width": 32, "height": 32,
                  "fill": "$color.surfaceRaised",
                  "layout": "horizontal", "justifyContent": "center", "alignItems": "center",
                  "children": [
                    { "id": "prp2-text", "type": "text", "content": "2", "fill": "$color.textSecondary", "fontFamily": "$font.mono", "fontSize": 12 }
                  ]
                }
              ]
            }
          ]
        },
        { "id": "pr-footer", "type": "ref", "ref": "footer-main" }
      ]
    },

