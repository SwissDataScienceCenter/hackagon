    {
      "id": "homepage-light",
      "name": "Homepage — Public (Light Mode, Desktop 1440px)",
      "context": "Light mode variant of the public homepage. Uses the same layout and content as the dark mode version, but with all theme variables resolved to their light values. Place side by side with the dark version for comparison.",
      "type": "ref",
      "ref": "homepage",
      "theme": { "mode": "light" },
      "x": 12400, "y": 0
    },

    {
      "id": "hackathon-loggedin-light",
      "name": "Hackathon Page — Logged In (Light Mode, Desktop 1440px)",
      "context": "Light mode variant of the logged-in hackathon page. Uses the same layout and content as the dark mode version, but with all theme variables resolved to their light values.",
      "type": "ref",
      "ref": "hackathon-loggedin",
      "theme": { "mode": "light" },
