                        { "id": "hli-prop-item-2", "type": "ref", "ref": "hli-prop-item", "descendants": { "pi-num-title": { "content": "15. Automatic extraction of data from literature" }, "pi-desc": { "content": "Have you ever been frustrated by having to copy data..." } } },
                        {
