                          "type": "frame", "width": "fill_container", "height": "fit_content",
                          "layout": "vertical", "gap": 8,
                          "padding": 16,
                          "children": [
                            { "id": "hli-ac-team-label", "type": "text", "content": "YOUR TEAM", "fill": "$color.textMuted", "fontFamily": "$font.mono", "fontSize": 10, "fontWeight": "700", "letterSpacing": 1 },
                            { "id": "hli-ac-team-name", "type": "text", "content": "Bishorn", "fill": "$color.text", "fontFamily": "$font.mono", "fontSize": 14, "fontWeight": "600" },
                            {
