{
  "version": "2.10",
  "themes": {
    "mode": ["dark", "light"]
  },
  "variables": {
    "color.bg": {
      "type": "color",
      "value": [
        { "value": "#161616", "theme": { "mode": "dark" } },
        { "value": "#FFFFFF", "theme": { "mode": "light" } }
      ]
    },
    "color.surface": {
      "type": "color",
      "value": [
        { "value": "#1E1E1E", "theme": { "mode": "dark" } },
        { "value": "#FAFAFA", "theme": { "mode": "light" } }
      ]
    },
    "color.surfaceRaised": {
      "type": "color",
      "value": [
        { "value": "#262626", "theme": { "mode": "dark" } },
        { "value": "#F0F0F0", "theme": { "mode": "light" } }
      ]
    },
    "color.border": {
      "type": "color",
      "value": [
        { "value": "#333333", "theme": { "mode": "dark" } },
        { "value": "#E0E0E0", "theme": { "mode": "light" } }
      ]
    },
    "color.text": {
      "type": "color",
      "value": [
        { "value": "#F0F0F0", "theme": { "mode": "dark" } },
        { "value": "#161616", "theme": { "mode": "light" } }
      ]
    },
    "color.textSecondary": {
      "type": "color",
      "value": [
        { "value": "#A0A0A0", "theme": { "mode": "dark" } },
        { "value": "#6B6B6B", "theme": { "mode": "light" } }
      ]
    },
    "color.textMuted": {
      "type": "color",
      "value": [
        { "value": "#666666", "theme": { "mode": "dark" } },
        { "value": "#999999", "theme": { "mode": "light" } }
      ]
    },
    "color.primary": { "type": "color", "value": "#6ABF4B" },
    "color.primaryMuted": {
      "type": "color",
      "value": [
        { "value": "#1F3318", "theme": { "mode": "dark" } },
        { "value": "#E8F5E0", "theme": { "mode": "light" } }
      ]
    },
    "color.primaryDark": { "type": "color", "value": "#3D8A2E" },
    "color.secondary": { "type": "color", "value": "#5A4D8A" },
    "color.secondaryMuted": {
      "type": "color",
      "value": [
        { "value": "#1E1A2E", "theme": { "mode": "dark" } },
        { "value": "#EEEAF5", "theme": { "mode": "light" } }
      ]
    },
    "color.accent": { "type": "color", "value": "#FFD700" },
    "color.onPrimary": { "type": "color", "value": "#0A1A06" },
    "font.mono": { "type": "string", "value": "Source Code Pro" },
    "size.px": { "type": "number", "value": 80 },
    "size.contentMax": { "type": "number", "value": 1280 }
  },
  "children": [

    {
      "id": "nav-bar",
      "name": "Navigation Bar (reusable)",
      "type": "frame",
      "reusable": true,
      "x": 0, "y": -80,
      "width": 1440,
      "height": 56,
      "fill": "$color.bg",
      "layout": "horizontal",
      "justifyContent": "space_between",
      "alignItems": "center",
      "padding": [0, 32, 0, 32],
      "stroke": { "align": "inside", "thickness": { "bottom": 1 }, "fill": "$color.border" },
      "children": [
        {
          "id": "nav-left",
          "type": "frame",
          "width": "fit_content", "height": "fit_content",
          "layout": "horizontal", "alignItems": "center", "gap": 12,
          "children": [
            { "id": "nav-logo", "type": "rectangle", "width": 28, "height": 28, "fill": "$color.primary" },
            { "id": "nav-brand", "type": "text", "content": "SDSC Hackathons", "fill": "$color.text", "fontFamily": "$font.mono", "fontSize": 15, "fontWeight": "700" }
          ]
        },
        {
          "id": "nav-center",
          "type": "frame",
          "width": "fit_content", "height": "fit_content",
          "layout": "horizontal", "alignItems": "center", "gap": 24,
          "children": [
            { "id": "nav-link-hackathons", "type": "text", "content": "Hackathons", "fill": "$color.text", "fontFamily": "$font.mono", "fontSize": 13, "fontWeight": "500" },
            { "id": "nav-link-challenges", "type": "text", "content": "Challenges", "fill": "$color.textSecondary", "fontFamily": "$font.mono", "fontSize": 13 },
            { "id": "nav-link-about", "type": "text", "content": "About", "fill": "$color.textSecondary", "fontFamily": "$font.mono", "fontSize": 13 }
          ]
        },
        {
          "id": "nav-right",
          "type": "frame",
          "width": "fit_content", "height": "fit_content",
          "layout": "horizontal", "alignItems": "center", "gap": 12,
          "children": [
            {
              "id": "nav-search",
              "type": "frame", "width": 200, "height": 32,
              "fill": "$color.surfaceRaised",
              "stroke": { "align": "inside", "thickness": 1, "fill": "$color.border" },
              "layout": "horizontal", "alignItems": "center", "padding": [0, 10, 0, 10], "gap": 8,
              "children": [
                { "id": "nav-search-icon", "type": "icon_font", "iconFontFamily": "lucide", "iconFontName": "search", "width": 14, "height": 14, "fill": "$color.textMuted" },
                { "id": "nav-search-placeholder", "type": "text", "content": "Search hackathons...", "fill": "$color.textMuted", "fontFamily": "$font.mono", "fontSize": 12 }
              ]
            },
            {
              "id": "nav-login-btn",
              "type": "frame", "width": 72, "height": 32,
              "fill": "$color.primary",
              "layout": "horizontal", "justifyContent": "center", "alignItems": "center",
              "children": [
                { "id": "nav-login-text", "type": "text", "content": "Log in", "fill": "$color.onPrimary", "fontFamily": "$font.mono", "fontSize": 13, "fontWeight": "600" }
              ]
            }
          ]
        }
      ]
    },

    {
      "id": "footer-main",
      "name": "Footer with Partner Logos (reusable)",
      "context": "Site-wide footer with SDSC, ETH Zurich, and EPFL logos on the left, text links on the right. Uses actual logo SVGs from /images/logos/.",
      "type": "frame",
      "reusable": true,
      "x": 0, "y": -160,
      "width": 1440,
      "height": 56,
      "fill": "$color.surface",
      "layout": "horizontal", "justifyContent": "space_between", "alignItems": "center",
      "padding": [0, 80, 0, 80],
      "stroke": { "align": "inside", "thickness": { "top": 1 }, "fill": "$color.border" },
      "children": [
        {
          "id": "ft-logos",
          "type": "frame", "width": "fit_content", "height": "fit_content",
          "layout": "horizontal", "gap": 20, "alignItems": "center",
          "children": [
            {
              "id": "ft-sdsc-logo",
              "name": "SDSC Logo (/images/logos/sdsc-logo-footer.svg)",
              "type": "rectangle", "width": 80, "height": 24,
              "fill": "$color.surfaceRaised",
              "stroke": { "align": "inside", "thickness": 1, "fill": "$color.border" }
            },
            { "id": "ft-sep-1", "type": "rectangle", "width": 1, "height": 18, "fill": "$color.border" },
            {
              "id": "ft-eth-logo",
              "name": "ETH Zurich Logo (/images/logos/eth-zurich.svg)",
              "type": "rectangle", "width": 80, "height": 24,
              "fill": "$color.surfaceRaised",
              "stroke": { "align": "inside", "thickness": 1, "fill": "$color.border" }
            },
            { "id": "ft-sep-2", "type": "rectangle", "width": 1, "height": 18, "fill": "$color.border" },
            {
              "id": "ft-epfl-logo",
              "name": "EPFL Logo (/images/logos/epfl.svg)",
              "type": "rectangle", "width": 60, "height": 24,
              "fill": "$color.surfaceRaised",
              "stroke": { "align": "inside", "thickness": 1, "fill": "$color.border" }
            }
          ]
        },
        { "id": "ft-links", "type": "text", "content": "Privacy  ·  Terms  ·  About  ·  GitHub", "fill": "$color.textMuted", "fontFamily": "$font.mono", "fontSize": 11 }
      ]
    },

    {
      "id": "homepage",
      "name": "Homepage — Public (Desktop 1440px)",
      "context": "HuggingFace-inspired public landing page. Full-width, no sidebars. Visitors see hero, trending hackathons with tabs, winners, organization logos, feature highlights, and CTA. Logged-in users get redirected to /welcome dashboard.",
      "type": "frame",
      "x": 0, "y": 0,
      "width": 1440,
      "height": "fit_content",
      "fill": "$color.bg",
      "layout": "vertical",
      "clip": true,
      "children": [

        { "id": "home-nav", "type": "ref", "ref": "nav-bar" },

        {
          "id": "hero",
          "name": "Hero Section",
          "context": "Full-width hero with background photo (/images/hackathon-ord-2024/ambiance/ambiance_1.jpg) darkened via overlay. Centered tagline, subtitle, two CTAs on top. Photo shows hackathon participants collaborating.",
          "type": "frame",
          "width": "fill_container", "height": 480,
          "fill": "$color.bg",
          "layout": "vertical", "justifyContent": "center", "alignItems": "center", "gap": 24,
          "padding": [40, 80, 60, 80],
          "clip": true,
          "children": [
            {
              "id": "hero-bg-image",
              "name": "Background Photo: /images/hackathon-ord-2024/ambiance/ambiance_1.jpg",
              "context": "Full-bleed background image showing participants at tables during ORD Hackathon 2024. Represented as a gradient placeholder. In implementation, use the actual photo with object-fit: cover.",
              "type": "rectangle",
              "layoutPosition": "absolute",
              "x": 0, "y": 0,
              "width": 1440, "height": 480,
              "fill": "$color.primaryMuted",
              "opacity": 0.5
            },
            {
              "id": "hero-overlay",
              "name": "Theme-aware overlay — fades to $color.bg",
              "context": "Solid fill using $color.bg so it's dark in dark mode, white in light mode. The photo shows through at reduced opacity.",
              "type": "rectangle",
              "layoutPosition": "absolute",
              "x": 0, "y": 0,
              "width": 1440, "height": 480,
              "fill": "$color.bg",
              "opacity": 0.65
            },
            {
              "id": "hero-eyebrow",
              "type": "frame", "width": "fit_content", "height": 26,
              "fill": "$color.primaryMuted",
              "stroke": { "align": "inside", "thickness": 1, "fill": "$color.primary" },
              "layout": "horizontal", "justifyContent": "center", "alignItems": "center",
              "padding": [4, 14, 4, 14], "gap": 6,
              "children": [
                { "id": "hero-eyebrow-dot", "type": "ellipse", "width": 6, "height": 6, "fill": "$color.primary" },
                { "id": "hero-eyebrow-text", "type": "text", "content": "ORD Hackathon 2026 — Registration open", "fill": "$color.primary", "fontFamily": "$font.mono", "fontSize": 11, "fontWeight": "600" }
              ]
            },
            {
              "id": "hero-title",
              "type": "text",
              "content": "The hackathon platform\nfor Swiss research.",
              "fill": "$color.text",
              "fontFamily": "$font.mono", "fontSize": 48, "fontWeight": "700",
              "textAlign": "center", "lineHeight": 1.15,
              "textGrowth": "fixed-width", "width": 700
            },
            {
              "id": "hero-subtitle",
              "type": "text",
              "content": "Propose projects, form teams, and build solutions together.\nHosted by SDSC for the Swiss scientific community.",
              "fill": "$color.textSecondary",
              "fontFamily": "$font.mono", "fontSize": 16, "textAlign": "center", "lineHeight": 1.6,
              "textGrowth": "fixed-width", "width": 560
            },
            {
              "id": "hero-ctas",
              "type": "frame",
              "width": "fit_content", "height": "fit_content",
              "layout": "horizontal", "gap": 12, "alignItems": "center",
              "children": [
                {
                  "id": "hero-cta-register",
                  "type": "frame", "width": 160, "height": 44,
                  "fill": "$color.primary",
                  "layout": "horizontal", "justifyContent": "center", "alignItems": "center",
                  "children": [
                    { "id": "hero-cta-register-text", "type": "text", "content": "Get Started", "fill": "$color.onPrimary", "fontFamily": "$font.mono", "fontSize": 14, "fontWeight": "600" }
                  ]
                },
                {
                  "id": "hero-cta-browse",
                  "type": "frame", "width": 200, "height": 44,
                  "stroke": { "align": "inside", "thickness": 1, "fill": "$color.border" },
                  "layout": "horizontal", "justifyContent": "center", "alignItems": "center", "gap": 6,
                  "children": [
                    { "id": "hero-cta-browse-text", "type": "text", "content": "Browse Hackathons", "fill": "$color.text", "fontFamily": "$font.mono", "fontSize": 14 },
                    { "id": "hero-cta-browse-arrow", "type": "icon_font", "iconFontFamily": "lucide", "iconFontName": "arrow-right", "width": 14, "height": 14, "fill": "$color.textSecondary" }
                  ]
                }
              ]
            }
          ]
        },

        {
          "id": "trending",
          "name": "Trending Section (HF-style tabs)",
          "context": "Like HuggingFace 'Trending on this week' section. Tabs to switch between Hackathons, Challenges, Past Events. Shows cards for each. This replaces separate Current/Past sections.",
          "type": "frame",
          "width": "fill_container", "height": "fit_content",
          "fill": "$color.bg",
          "layout": "vertical", "gap": 24,
          "padding": [48, 80, 48, 80],
          "stroke": { "align": "inside", "thickness": { "top": 1 }, "fill": "$color.border" },
          "children": [
            {
              "id": "trending-header",
              "type": "frame",
              "width": "fill_container", "height": "fit_content",
              "layout": "horizontal", "justifyContent": "space_between", "alignItems": "center",
              "children": [
                {
                  "id": "trending-title",
                  "type": "text", "content": "Trending this month",
                  "fill": "$color.text", "fontFamily": "$font.mono", "fontSize": 20, "fontWeight": "700"
                },
                {
                  "id": "trending-view-all",
                  "type": "text", "content": "Browse all ->",
                  "fill": "$color.primary", "fontFamily": "$font.mono", "fontSize": 13
                }
              ]
            },
            {
              "id": "trending-tabs",
              "type": "frame",
              "width": "fill_container", "height": "fit_content",
              "layout": "horizontal", "gap": 0,
              "stroke": { "align": "inside", "thickness": { "bottom": 1 }, "fill": "$color.border" },
              "children": [
                {
                  "id": "tab-hackathons",
                  "type": "frame", "width": "fit_content", "height": 36,
                  "layout": "horizontal", "alignItems": "center",
                  "padding": [0, 16, 0, 16],
                  "stroke": { "align": "inside", "thickness": { "bottom": 2 }, "fill": "$color.primary" },
                  "children": [
                    { "id": "tab-hackathons-icon", "type": "icon_font", "iconFontFamily": "lucide", "iconFontName": "code", "width": 14, "height": 14, "fill": "$color.primary" },
                    { "id": "tab-hackathons-label", "type": "text", "content": "  Hackathons", "fill": "$color.primary", "fontFamily": "$font.mono", "fontSize": 13, "fontWeight": "600" }
                  ]
                },
                {
                  "id": "tab-challenges",
                  "type": "frame", "width": "fit_content", "height": 36,
                  "layout": "horizontal", "alignItems": "center",
                  "padding": [0, 16, 0, 16],
                  "children": [
                    { "id": "tab-challenges-icon", "type": "icon_font", "iconFontFamily": "lucide", "iconFontName": "trophy", "width": 14, "height": 14, "fill": "$color.textMuted" },
                    { "id": "tab-challenges-label", "type": "text", "content": "  Challenges", "fill": "$color.textSecondary", "fontFamily": "$font.mono", "fontSize": 13 }
                  ]
                },
                {
                  "id": "tab-past",
                  "type": "frame", "width": "fit_content", "height": 36,
                  "layout": "horizontal", "alignItems": "center",
                  "padding": [0, 16, 0, 16],
                  "children": [
                    { "id": "tab-past-icon", "type": "icon_font", "iconFontFamily": "lucide", "iconFontName": "archive", "width": 14, "height": 14, "fill": "$color.textMuted" },
                    { "id": "tab-past-label", "type": "text", "content": "  Past Events", "fill": "$color.textSecondary", "fontFamily": "$font.mono", "fontSize": 13 }
                  ]
                }
              ]
            },
            {
              "id": "trending-list",
              "type": "frame",
              "width": "fill_container", "height": "fit_content",
              "layout": "vertical", "gap": 0,
              "children": [
                {
                  "id": "trending-row",
                  "name": "Trending Row",
                  "type": "frame",
                  "reusable": true,
                  "width": "fill_container", "height": 72,
                  "layout": "horizontal", "alignItems": "center", "gap": 16,
                  "padding": [0, 16, 0, 16],
                  "stroke": { "align": "inside", "thickness": { "bottom": 1 }, "fill": "$color.border" },
                  "children": [
                    { "id": "tr-index", "type": "text", "content": "1", "fill": "$color.textMuted", "fontFamily": "$font.mono", "fontSize": 14, "fontWeight": "600" },
                    {
                      "id": "tr-thumb",
                      "type": "rectangle", "width": 48, "height": 48,
                      "fill": {
                        "type": "gradient", "gradientType": "linear", "rotation": 135,
                        "colors": [ { "color": "#3D8A2E", "position": 0 }, { "color": "#1A2E14", "position": 1 } ]
                      }
                    },
                    {
                      "id": "tr-info",
                      "type": "frame",
                      "width": "fill_container", "height": "fit_content",
                      "layout": "vertical", "gap": 4,
                      "children": [
                        {
                          "id": "tr-title-row",
                          "type": "frame", "width": "fit_content", "height": "fit_content",
                          "layout": "horizontal", "gap": 8, "alignItems": "center",
                          "children": [
                            { "id": "tr-org", "type": "text", "content": "SDSC", "fill": "$color.textSecondary", "fontFamily": "$font.mono", "fontSize": 13 },
                            { "id": "tr-slash", "type": "text", "content": "/", "fill": "$color.textMuted", "fontFamily": "$font.mono", "fontSize": 13 },
                            { "id": "tr-name", "type": "text", "content": "ORD Hackathon 2026", "fill": "$color.text", "fontFamily": "$font.mono", "fontSize": 13, "fontWeight": "600" }
                          ]
                        },
                        { "id": "tr-meta", "type": "text", "content": "24 – 25 Oct 2026  ·  ETH Zurich  ·  42 registered", "fill": "$color.textMuted", "fontFamily": "$font.mono", "fontSize": 11 }
                      ]
                    },
                    {
                      "id": "tr-badge",
                      "type": "frame", "width": "fit_content", "height": 22,
                      "fill": "$color.primaryMuted",
                      "stroke": { "align": "inside", "thickness": 1, "fill": "$color.primaryDark" },
                      "layout": "horizontal", "justifyContent": "center", "alignItems": "center",
                      "padding": [2, 10, 2, 10],
                      "children": [
                        { "id": "tr-badge-text", "type": "text", "content": "Registration Open", "fill": "$color.primary", "fontFamily": "$font.mono", "fontSize": 10, "fontWeight": "600" }
                      ]
                    },
                    {
                      "id": "tr-stats",
                      "type": "frame", "width": "fit_content", "height": "fit_content",
                      "layout": "horizontal", "gap": 12, "alignItems": "center",
                      "children": [
                        {
                          "id": "tr-participants",
                          "type": "frame", "width": "fit_content", "height": "fit_content",
                          "layout": "horizontal", "gap": 4, "alignItems": "center",
                          "children": [
                            { "id": "tr-participants-icon", "type": "icon_font", "iconFontFamily": "lucide", "iconFontName": "users", "width": 12, "height": 12, "fill": "$color.textMuted" },
                            { "id": "tr-participants-count", "type": "text", "content": "42", "fill": "$color.textMuted", "fontFamily": "$font.mono", "fontSize": 12 }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "trending-row-2",
                  "type": "ref", "ref": "trending-row",
                  "descendants": {
                    "tr-index": { "content": "2" },
                    "tr-thumb": {
                      "fill": { "type": "gradient", "gradientType": "linear", "rotation": 135,
                        "colors": [ { "color": "#5A4D8A", "position": 0 }, { "color": "#2A2040", "position": 1 } ] }
                    },
                    "tr-name": { "content": "Generative AI for Science" },
                    "tr-meta": { "content": "14 – 15 Nov 2026  ·  EPFL, Lausanne" },
                    "tr-badge-text": { "content": "Upcoming" },
                    "tr-badge": { "fill": "$color.secondaryMuted", "stroke": { "align": "inside", "thickness": 1, "fill": "$color.secondary" } },
                    "tr-participants-count": { "content": "—" }
                  }
                },
                {
                  "id": "trending-row-3",
                  "type": "ref", "ref": "trending-row",
                  "descendants": {
                    "tr-index": { "content": "3" },
                    "tr-thumb": {
                      "fill": { "type": "gradient", "gradientType": "linear", "rotation": 135,
                        "colors": [ { "color": "#8A7A2E", "position": 0 }, { "color": "#2E2A14", "position": 1 } ] }
                    },
                    "tr-name": { "content": "Global Wheat Challenge 2026" },
                    "tr-meta": { "content": "1 Sep – 30 Nov 2026  ·  Online  ·  87 registered" },
                    "tr-participants-count": { "content": "87" }
                  }
                },
                {
                  "id": "trending-row-4",
                  "type": "ref", "ref": "trending-row",
                  "descendants": {
                    "tr-index": { "content": "4" },
                    "tr-thumb": {
                      "fill": { "type": "gradient", "gradientType": "linear", "rotation": 135,
                        "colors": [ { "color": "#2E5A8A", "position": 0 }, { "color": "#142A3E", "position": 1 } ] }
                    },
                    "tr-name": { "content": "Climate Data Challenge 2025" },
                    "tr-meta": { "content": "5 – 6 Jun 2025  ·  Univ. of Bern  ·  64 participants" },
                    "tr-badge-text": { "content": "Completed" },
                    "tr-badge": { "fill": "$color.surfaceRaised", "stroke": { "align": "inside", "thickness": 1, "fill": "$color.border" } },
                    "tr-participants-count": { "content": "64" }
                  }
                },
                {
                  "id": "trending-row-5",
                  "type": "ref", "ref": "trending-row",
                  "descendants": {
                    "tr-index": { "content": "5" },
                    "tr-thumb": {
                      "fill": { "type": "gradient", "gradientType": "linear", "rotation": 135,
                        "colors": [ { "color": "#3D8A2E", "position": 0 }, { "color": "#1A2E14", "position": 1 } ] }
                    },
                    "tr-name": { "content": "ORD Hackathon 2025" },
                    "tr-meta": { "content": "18 – 19 Oct 2025  ·  ETH Zurich  ·  78 participants" },
                    "tr-badge-text": { "content": "Completed" },
                    "tr-badge": { "fill": "$color.surfaceRaised", "stroke": { "align": "inside", "thickness": 1, "fill": "$color.border" } },
                    "tr-participants-count": { "content": "78" }
                  }
                }
              ]
            }
          ]
        },

        {
          "id": "winners",
          "name": "Winners Section",
          "context": "Like HuggingFace Spaces showcase — horizontal cards showing winning projects with trophy, team, hackathon source. Links to project details.",
          "type": "frame",
          "width": "fill_container", "height": "fit_content",
          "fill": "$color.bg",
          "layout": "vertical", "gap": 24,
          "padding": [48, 80, 48, 80],
          "stroke": { "align": "inside", "thickness": { "top": 1 }, "fill": "$color.border" },
          "children": [
            {
              "id": "winners-header",
              "type": "frame", "width": "fill_container", "height": "fit_content",
              "layout": "horizontal", "justifyContent": "space_between", "alignItems": "center",
              "children": [
                { "id": "winners-title", "type": "text", "content": "Award-winning projects", "fill": "$color.text", "fontFamily": "$font.mono", "fontSize": 20, "fontWeight": "700" },
                { "id": "winners-see-all", "type": "text", "content": "See all ->", "fill": "$color.primary", "fontFamily": "$font.mono", "fontSize": 13 }
              ]
            },
            {
              "id": "winners-grid",
              "type": "frame",
              "width": "fill_container", "height": "fit_content",
              "layout": "horizontal", "gap": 16,
              "children": [
                {
                  "id": "winner-card",
                  "name": "Winner Card",
                  "type": "frame",
                  "reusable": true,
                  "width": "fill_container", "height": "fit_content",
                  "fill": "$color.surface",
                  "stroke": { "align": "inside", "thickness": 1, "fill": "$color.border" },
                  "layout": "vertical", "gap": 0,
                  "children": [
                    {
                      "id": "wc-header",
                      "type": "frame", "width": "fill_container", "height": 40,
                      "fill": "$color.primaryMuted",
                      "layout": "horizontal", "alignItems": "center", "justifyContent": "space_between",
                      "padding": [0, 16, 0, 16],
                      "children": [
                        {
                          "id": "wc-trophy-row",
                          "type": "frame", "width": "fit_content", "height": "fit_content",
                          "layout": "horizontal", "gap": 6, "alignItems": "center",
                          "children": [
                            { "id": "wc-trophy", "type": "icon_font", "iconFontFamily": "lucide", "iconFontName": "trophy", "width": 14, "height": 14, "fill": "$color.accent" },
                            { "id": "wc-place", "type": "text", "content": "1st Place", "fill": "$color.accent", "fontFamily": "$font.mono", "fontSize": 11, "fontWeight": "700" }
                          ]
                        },
                        { "id": "wc-hackathon", "type": "text", "content": "ORD Hackathon 2025", "fill": "$color.textMuted", "fontFamily": "$font.mono", "fontSize": 11 }
                      ]
                    },
                    {
                      "id": "wc-body",
                      "type": "frame", "width": "fill_container", "height": "fit_content",
                      "layout": "vertical", "gap": 8, "padding": 16,
                      "children": [
                        { "id": "wc-project", "type": "text", "content": "AutoORD: Automated\nResearch Data Pipelines", "fill": "$color.text", "fontFamily": "$font.mono", "fontSize": 14, "fontWeight": "600", "lineHeight": 1.3, "textGrowth": "fixed-width", "width": 360 },
                        { "id": "wc-team", "type": "text", "content": "by Team DataFlow", "fill": "$color.primary", "fontFamily": "$font.mono", "fontSize": 12 },
                        { "id": "wc-summary", "type": "text", "content": "Automated pipeline for converting raw research data into FAIR-compliant open datasets.", "fill": "$color.textSecondary", "fontFamily": "$font.mono", "fontSize": 12, "lineHeight": 1.4, "textGrowth": "fixed-width", "width": 360 }
                      ]
                    }
                  ]
                },
                {
                  "id": "winner-card-2", "type": "ref", "ref": "winner-card",
                  "descendants": {
                    "wc-hackathon": { "content": "GenAI Hackathon 2025" },
                    "wc-project": { "content": "GenomeLens" },
                    "wc-team": { "content": "by BioViz Crew" },
                    "wc-summary": { "content": "Interactive visualization of genomic variants powered by generative models." }
                  }
                },
                {
                  "id": "winner-card-3", "type": "ref", "ref": "winner-card",
                  "descendants": {
                    "wc-hackathon": { "content": "Climate Data 2025" },
                    "wc-project": { "content": "ClimateQA" },
                    "wc-team": { "content": "by Green Bytes" },
                    "wc-summary": { "content": "RAG-based Q&A trained on Swiss climate data, making decades of measurements queryable." }
                  }
                }
              ]
            }
          ]
        },

        {
          "id": "event-showcase",
          "name": "Event Showcase Carousel",
          "context": "Horizontal scrollable carousel of event photos showcasing past hackathons. Uses real photos from /images/hackathon-ord-2024/ — ambiance, teams, winners. Auto-advances, with dot indicators. Gives visitors a feel for the energy and scale of the events.",
          "type": "frame",
          "width": "fill_container", "height": "fit_content",
          "fill": "$color.bg",
          "layout": "vertical", "gap": 24,
          "padding": [48, 80, 48, 80],
          "stroke": { "align": "inside", "thickness": { "top": 1 }, "fill": "$color.border" },
          "children": [
            {
              "id": "es-header",
              "type": "frame", "width": "fill_container", "height": "fit_content",
              "layout": "horizontal", "justifyContent": "space_between", "alignItems": "center",
              "children": [
                {
                  "id": "es-title-row",
                  "type": "frame", "width": "fit_content", "height": "fit_content",
                  "layout": "horizontal", "gap": 8, "alignItems": "center",
                  "children": [
                    { "id": "es-icon", "type": "icon_font", "iconFontFamily": "lucide", "iconFontName": "images", "width": 18, "height": 18, "fill": "$color.primary" },
                    { "id": "es-title", "type": "text", "content": "From our events", "fill": "$color.text", "fontFamily": "$font.mono", "fontSize": 20, "fontWeight": "700" }
                  ]
                },
                {
                  "id": "es-nav-arrows",
                  "type": "frame", "width": "fit_content", "height": "fit_content",
                  "layout": "horizontal", "gap": 8,
                  "children": [
                    {
                      "id": "es-prev",
                      "type": "frame", "width": 32, "height": 32,
                      "fill": "$color.surfaceRaised",
                      "stroke": { "align": "inside", "thickness": 1, "fill": "$color.border" },
                      "layout": "horizontal", "justifyContent": "center", "alignItems": "center",
                      "children": [
                        { "id": "es-prev-icon", "type": "icon_font", "iconFontFamily": "lucide", "iconFontName": "chevron-left", "width": 16, "height": 16, "fill": "$color.textSecondary" }
                      ]
                    },
                    {
                      "id": "es-next",
                      "type": "frame", "width": 32, "height": 32,
                      "fill": "$color.surfaceRaised",
                      "stroke": { "align": "inside", "thickness": 1, "fill": "$color.border" },
                      "layout": "horizontal", "justifyContent": "center", "alignItems": "center",
                      "children": [
                        { "id": "es-next-icon", "type": "icon_font", "iconFontFamily": "lucide", "iconFontName": "chevron-right", "width": 16, "height": 16, "fill": "$color.textSecondary" }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "es-carousel",
              "name": "Photo Carousel Strip",
              "context": "Horizontal scroll showing 4 visible photos at a time. Each photo is from a real hackathon event. Clicking opens a lightbox. On mobile, shows 1-2 at a time with swipe.",
              "type": "frame",
              "width": "fill_container", "height": "fit_content",
              "layout": "horizontal", "gap": 16,
              "clip": true,
              "children": [
                {
                  "id": "es-slide",
                  "name": "Carousel Slide",
                  "type": "frame",
                  "reusable": true,
                  "width": 300, "height": 200,
                  "fill": "$color.surface",
                  "stroke": { "align": "inside", "thickness": 1, "fill": "$color.border" },
                  "layout": "vertical", "gap": 0,
                  "clip": true,
                  "children": [
                    {
                      "id": "es-slide-image",
                      "name": "Photo: /images/hackathon-ord-2024/ambiance/ambiance_1.jpg",
                      "type": "rectangle", "width": 300, "height": 160,
                      "fill": {
                        "type": "gradient", "gradientType": "linear", "rotation": 135,
                        "colors": [ { "color": "#2E5A3A", "position": 0 }, { "color": "#1A2E14", "position": 1 } ]
                      }
                    },
                    {
                      "id": "es-slide-caption",
                      "type": "frame", "width": "fill_container", "height": 40,
                      "fill": "$color.surface",
                      "layout": "horizontal", "alignItems": "center",
                      "padding": [0, 12, 0, 12],
                      "children": [
                        { "id": "es-slide-text", "type": "text", "content": "ORD Hackathon 2024 — Teams collaborating", "fill": "$color.textMuted", "fontFamily": "$font.mono", "fontSize": 11 }
                      ]
                    }
                  ]
                },
                {
                  "id": "es-slide-2", "type": "ref", "ref": "es-slide",
                  "descendants": {
                    "es-slide-image": {
                      "name": "Photo: /images/hackathon-ord-2024/ambiance/ambiance_3.jpg",
                      "fill": { "type": "gradient", "gradientType": "linear", "rotation": 150, "colors": [ { "color": "#3A2E5A", "position": 0 }, { "color": "#201A2E", "position": 1 } ] }
                    },
                    "es-slide-text": { "content": "ORD Hackathon 2024 — Working sessions" }
                  }
                },
                {
                  "id": "es-slide-3", "type": "ref", "ref": "es-slide",
                  "descendants": {
                    "es-slide-image": {
                      "name": "Photo: /images/hackathon-ord-2024/winners/winners_1.jpg",
                      "fill": { "type": "gradient", "gradientType": "linear", "rotation": 120, "colors": [ { "color": "#5A4A2E", "position": 0 }, { "color": "#2E2A1A", "position": 1 } ] }
                    },
                    "es-slide-text": { "content": "ORD Hackathon 2024 — Award ceremony" }
                  }
                },
                {
                  "id": "es-slide-4", "type": "ref", "ref": "es-slide",
                  "descendants": {
                    "es-slide-image": {
                      "name": "Photo: /images/hackathon-ord-2024/teams/teams_1.jpg",
                      "fill": { "type": "gradient", "gradientType": "linear", "rotation": 100, "colors": [ { "color": "#2E5A8A", "position": 0 }, { "color": "#142A3E", "position": 1 } ] }
                    },
                    "es-slide-text": { "content": "ORD Hackathon 2024 — Team presentations" }
                  }
                }
              ]
            },
            {
              "id": "es-dots",
              "name": "Carousel Indicators",
              "type": "frame",
              "width": "fill_container", "height": "fit_content",
              "layout": "horizontal", "justifyContent": "center", "gap": 8,
              "children": [
                { "id": "es-dot-1", "type": "ellipse", "width": 8, "height": 8, "fill": "$color.primary" },
                { "id": "es-dot-2", "type": "ellipse", "width": 8, "height": 8, "fill": "$color.surfaceRaised" },
                { "id": "es-dot-3", "type": "ellipse", "width": 8, "height": 8, "fill": "$color.surfaceRaised" },
                { "id": "es-dot-4", "type": "ellipse", "width": 8, "height": 8, "fill": "$color.surfaceRaised" }
              ]
            }
          ]
        },

        {
          "id": "features",
          "name": "Features Section (HF-style)",
          "context": "Like HuggingFace 'The Home of Machine Learning' section. 2x2 grid of feature cards explaining what the platform does. Maps to Skeleton card + preset-tonal-surface.",
          "type": "frame",
          "width": "fill_container", "height": "fit_content",
          "fill": "$color.surface",
          "layout": "vertical", "gap": 32,
          "padding": [64, 80, 64, 80],
          "stroke": { "align": "inside", "thickness": { "top": 1 }, "fill": "$color.border" },
          "children": [
            {
              "id": "features-header",
              "type": "frame", "width": "fill_container", "height": "fit_content",
              "layout": "vertical", "alignItems": "center", "gap": 8,
              "children": [
                { "id": "features-title", "type": "text", "content": "The hackathon platform for science", "fill": "$color.text", "fontFamily": "$font.mono", "fontSize": 28, "fontWeight": "700", "textAlign": "center" },
                { "id": "features-subtitle", "type": "text", "content": "Everything you need to run or participate in a hackathon.", "fill": "$color.textSecondary", "fontFamily": "$font.mono", "fontSize": 15, "textAlign": "center" }
              ]
            },
            {
              "id": "features-grid",
              "type": "frame",
              "width": "fill_container", "height": "fit_content",
              "layout": "horizontal", "gap": 16,
              "children": [
                {
                  "id": "feat-col-1",
                  "type": "frame", "width": "fill_container", "height": "fit_content",
                  "layout": "vertical", "gap": 16,
                  "children": [
                    {
                      "id": "feat-1",
                      "type": "frame", "width": "fill_container", "height": "fit_content",
                      "fill": "$color.surfaceRaised",
                      "stroke": { "align": "inside", "thickness": 1, "fill": "$color.border" },
                      "layout": "vertical", "gap": 12, "padding": 24,
                      "children": [
                        { "id": "feat-1-icon", "type": "icon_font", "iconFontFamily": "lucide", "iconFontName": "lightbulb", "width": 24, "height": 24, "fill": "$color.primary" },
                        { "id": "feat-1-title", "type": "text", "content": "Propose & discover projects", "fill": "$color.text", "fontFamily": "$font.mono", "fontSize": 16, "fontWeight": "600" },
                        { "id": "feat-1-desc", "type": "text", "content": "Submit project ideas, browse proposals from other participants, and find the challenge that matches your skills.", "fill": "$color.textSecondary", "fontFamily": "$font.mono", "fontSize": 13, "lineHeight": 1.5, "textGrowth": "fixed-width", "width": 520 }
                      ]
                    },
                    {
                      "id": "feat-2",
                      "type": "frame", "width": "fill_container", "height": "fit_content",
                      "fill": "$color.surfaceRaised",
                      "stroke": { "align": "inside", "thickness": 1, "fill": "$color.border" },
                      "layout": "vertical", "gap": 12, "padding": 24,
                      "children": [
                        { "id": "feat-2-icon", "type": "icon_font", "iconFontFamily": "lucide", "iconFontName": "users", "width": 24, "height": 24, "fill": "$color.primary" },
                        { "id": "feat-2-title", "type": "text", "content": "Smart team formation", "fill": "$color.text", "fontFamily": "$font.mono", "fontSize": 16, "fontWeight": "600" },
                        { "id": "feat-2-desc", "type": "text", "content": "Rank your project preferences and get matched into balanced teams. Organizers can fine-tune assignments.", "fill": "$color.textSecondary", "fontFamily": "$font.mono", "fontSize": 13, "lineHeight": 1.5, "textGrowth": "fixed-width", "width": 520 }
                      ]
                    }
                  ]
                },
                {
                  "id": "feat-col-2",
                  "type": "frame", "width": "fill_container", "height": "fit_content",
                  "layout": "vertical", "gap": 16,
                  "children": [
                    {
                      "id": "feat-3",
                      "type": "frame", "width": "fill_container", "height": "fit_content",
                      "fill": "$color.surfaceRaised",
                      "stroke": { "align": "inside", "thickness": 1, "fill": "$color.border" },
                      "layout": "vertical", "gap": 12, "padding": 24,
                      "children": [
                        { "id": "feat-3-icon", "type": "icon_font", "iconFontFamily": "lucide", "iconFontName": "upload", "width": 24, "height": 24, "fill": "$color.primary" },
                        { "id": "feat-3-title", "type": "text", "content": "Submit & showcase work", "fill": "$color.text", "fontFamily": "$font.mono", "fontSize": 16, "fontWeight": "600" },
                        { "id": "feat-3-desc", "type": "text", "content": "Submit your project with links, repos, slides and demos. Draft and iterate before the final deadline.", "fill": "$color.textSecondary", "fontFamily": "$font.mono", "fontSize": 13, "lineHeight": 1.5, "textGrowth": "fixed-width", "width": 520 }
                      ]
                    },
                    {
                      "id": "feat-4",
                      "type": "frame", "width": "fill_container", "height": "fit_content",
                      "fill": "$color.surfaceRaised",
                      "stroke": { "align": "inside", "thickness": 1, "fill": "$color.border" },
                      "layout": "vertical", "gap": 12, "padding": 24,
                      "children": [
                        { "id": "feat-4-icon", "type": "icon_font", "iconFontFamily": "lucide", "iconFontName": "vote", "width": 24, "height": 24, "fill": "$color.primary" },
                        { "id": "feat-4-title", "type": "text", "content": "Vote & leaderboard", "fill": "$color.text", "fontFamily": "$font.mono", "fontSize": 16, "fontWeight": "600" },
                        { "id": "feat-4-desc", "type": "text", "content": "Participants and jury vote on submissions. Results are aggregated into a live leaderboard with configurable scoring.", "fill": "$color.textSecondary", "fontFamily": "$font.mono", "fontSize": 13, "lineHeight": 1.5, "textGrowth": "fixed-width", "width": 520 }
                      ]
                    }
                  ]
                }
              ]
