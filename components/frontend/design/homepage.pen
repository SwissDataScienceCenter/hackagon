{
  "version": "2.11",
  "children": [
    {
      "type": "frame",
      "id": "nav-bar",
      "x": 0,
      "y": -80,
      "name": "Navigation Bar (reusable)",
      "reusable": true,
      "width": 1440,
      "height": 56,
      "fill": "$color.bg",
      "stroke": {
        "align": "inside",
        "thickness": {
          "bottom": 1
        },
        "fill": "$color.border"
      },
      "padding": [
        0,
        32
      ],
      "justifyContent": "space_between",
      "alignItems": "center",
      "children": [
        {
          "type": "frame",
          "id": "nav-left",
          "gap": 12,
          "alignItems": "center",
          "children": [
            {
              "type": "rectangle",
              "id": "nav-logo",
              "fill": "$color.primary",
              "width": 28,
              "height": 28
            },
            {
              "type": "text",
              "id": "nav-brand",
              "fill": "$color.text",
              "content": "SDSC Hackathons",
              "fontFamily": "$font.mono",
              "fontSize": 15,
              "fontWeight": "700"
            }
          ]
        },
        {
          "type": "frame",
          "id": "nav-center",
          "gap": 24,
          "alignItems": "center",
