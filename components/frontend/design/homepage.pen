                    { "id": "org-4-name", "type": "text", "content": "Univ. of Bern", "fill": "$color.textSecondary", "fontFamily": "$font.mono", "fontSize": 12, "fontWeight": "500" }
                  ]
                },
                {
                  "id": "org-5",
                  "type": "frame", "width": "fit_content", "height": "fit_content",
                  "layout": "vertical", "gap": 8, "alignItems": "center",
