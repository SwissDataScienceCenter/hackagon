        {
          "id": "cta-organize",
          "name": "Organize CTA",
          "context": "Call to action for potential hackathon organizers. Tonal primary background like HF enterprise section.",
          "type": "frame",
          "width": "fill_container", "height": "fit_content",
          "fill": "$color.primaryMuted",
          "layout": "horizontal", "alignItems": "center", "justifyContent": "space_between",
          "padding": [48, 80, 48, 80],
          "stroke": { "align": "inside", "thickness": { "top": 1, "bottom": 1 }, "fill": "$color.primaryDark" },
          "children": [
            {
              "id": "cta-text-block",
              "type": "frame", "width": "fit_content", "height": "fit_content",
              "layout": "vertical", "gap": 8,
              "children": [
                { "id": "cta-title", "type": "text", "content": "Want to host your own hackathon?", "fill": "$color.text", "fontFamily": "$font.mono", "fontSize": 22, "fontWeight": "700" },
                { "id": "cta-desc", "type": "text", "content": "SDSC provides the platform, tools, and expertise. Bring your challenge — we'll help you run it.", "fill": "$color.textSecondary", "fontFamily": "$font.mono", "fontSize": 14, "lineHeight": 1.5, "textGrowth": "fixed-width", "width": 560 }
              ]
            },
