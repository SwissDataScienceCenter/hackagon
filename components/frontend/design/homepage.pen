            { "id": "hli-tab-proposals", "type": "ref", "ref": "hli-tab", "descendants": { "tab-text": { "content": "Proposals", "fill": "$color.textSecondary" } }, "stroke": { "align": "inside", "thickness": { "bottom": 0 }, "fill": "transparent" } },
            { "id": "hli-tab-teams", "type": "ref", "ref": "hli-tab", "descendants": { "tab-text": { "content": "Teams", "fill": "$color.textSecondary" } }, "stroke": { "align": "inside", "thickness": { "bottom": 0 }, "fill": "transparent" } },
            { "id": "hli-tab-submissions", "type": "ref", "ref": "hli-tab", "descendants": { "tab-text": { "content": "Submissions", "fill": "$color.textSecondary" } }, "stroke": { "align": "inside", "thickness": { "bottom": 0 }, "fill": "transparent" } },
            { "id": "hli-tab-timeline", "type": "ref", "ref": "hli-tab", "descendants": { "tab-text": { "content": "Timeline", "fill": "$color.textSecondary" } }, "stroke": { "align": "inside", "thickness": { "bottom": 0 }, "fill": "transparent" } },
            { "id": "hli-tab-webinars", "type": "ref", "ref": "hli-tab", "descendants": { "tab-text": { "content": "Webinars", "fill": "$color.textSecondary" } }, "stroke": { "align": "inside", "thickness": { "bottom": 0 }, "fill": "transparent" } },
            { "id": "hli-tab-photos", "type": "ref", "ref": "hli-tab", "descendants": { "tab-text": { "content": "Photos", "fill": "$color.textSecondary" } }, "stroke": { "align": "inside", "thickness": { "bottom": 0 }, "fill": "transparent" } }
          ]
