    {
      "type": "frame",
      "id": "homepage",
      "x": 0,
      "y": 0,
      "name": "Homepage — Public (Desktop 1440px)",
      "context": "HuggingFace-inspired public landing page. Full-width, no sidebars. Visitors see hero, trending hackathons with tabs, winners, organization logos, feature highlights, and CTA. Logged-in users get redirected to /welcome dashboard.",
      "clip": true,
      "width": 1440,
      "fill": "$color.bg",
      "layout": "vertical",
      "children": [
        {
          "id": "home-nav",
          "type": "ref",
          "ref": "nav-bar"
        },
        {
          "type": "frame",
          "id": "hero",
          "name": "Hero Section",
          "context": "Full-width hero with background photo (/images/hackathon-ord-2024/ambiance/ambiance_1.jpg) darkened via overlay. Centered tagline, subtitle, two CTAs on top. Photo shows hackathon participants collaborating.",
          "clip": true,
          "width": "fill_container",
          "height": 480,
          "fill": "$color.bg",
          "layout": "vertical",
          "gap": 24,
          "padding": [
            40,
            80,
            60,
            80
          ],
          "justifyContent": "center",
          "alignItems": "center",
          "children": [
            {
              "type": "rectangle",
              "id": "hero-bg-image",
              "layoutPosition": "absolute",
              "x": 0,
              "y": 0,
              "name": "Background Photo: /images/hackathon-ord-2024/ambiance/ambiance_1.jpg",
              "context": "Full-bleed background image showing participants at tables during ORD Hackathon 2024. Represented as a gradient placeholder. In implementation, use the actual photo with object-fit: cover.",
              "opacity": 0.5,
              "fill": "$color.primaryMuted",
              "width": 1440,
              "height": 480
            },
            {
              "type": "rectangle",
              "id": "hero-overlay",
              "layoutPosition": "absolute",
              "x": 0,
              "y": 0,
              "name": "Theme-aware overlay — fades to $color.bg",
              "context": "Solid fill using $color.bg so it's dark in dark mode, white in light mode. The photo shows through at reduced opacity.",
              "opacity": 0.65,
              "fill": "$color.bg",
              "width": 1440,
              "height": 480
            },
            {
              "type": "frame",
              "id": "hero-eyebrow",
              "height": 26,
              "fill": "$color.primaryMuted",
              "stroke": {
                "align": "inside",
                "thickness": 1,
                "fill": "$color.primary"
              },
              "gap": 6,
              "padding": [
                4,
                14
              ],
              "justifyContent": "center",
              "alignItems": "center",
              "children": [
                {
                  "type": "ellipse",
                  "id": "hero-eyebrow-dot",
                  "fill": "$color.primary",
                  "width": 6,
                  "height": 6
                },
                {
                  "type": "text",
                  "id": "hero-eyebrow-text",
                  "fill": "$color.primary",
                  "content": "ORD Hackathon 2026 — Registration open",
                  "fontFamily": "$font.mono",
                  "fontSize": 11,
                  "fontWeight": "600"
                }
              ]
            },
            {
              "type": "text",
              "id": "hero-title",
              "fill": "$color.text",
              "textGrowth": "fixed-width",
              "width": 700,
              "content": "The hackathon platform\nfor Swiss research.",
              "lineHeight": 1.15,
              "textAlign": "center",
              "fontFamily": "$font.mono",
              "fontSize": 48,
              "fontWeight": "700"
            },
            {
              "type": "text",
              "id": "hero-subtitle",
              "fill": "$color.textSecondary",
              "textGrowth": "fixed-width",
              "width": 560,
              "content": "Propose projects, form teams, and build solutions together.\nHosted by SDSC for the Swiss scientific community.",
              "lineHeight": 1.6,
              "textAlign": "center",
              "fontFamily": "$font.mono",
              "fontSize": 16,
              "fontWeight": "normal"
            },
            {
              "type": "frame",
              "id": "hero-ctas",
              "gap": 12,
              "alignItems": "center",
              "children": [
                {
                  "type": "frame",
