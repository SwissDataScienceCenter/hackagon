                            { "id": "hli-al-users", "type": "ref", "ref": "hli-al", "descendants": { "al-icon": { "iconFontName": "users" }, "al-text": { "content": "Manage Users" } } },
                            { "id": "hli-al-projects", "type": "ref", "ref": "hli-al", "descendants": { "al-icon": { "iconFontName": "folder" }, "al-text": { "content": "Manage Projects" } } },
                            { "id": "hli-al-teams", "type": "ref", "ref": "hli-al", "descendants": { "al-icon": { "iconFontName": "users" }, "al-text": { "content": "Manage Teams" } } },
                            { "id": "hli-al-votes", "type": "ref", "ref": "hli-al", "descendants": { "al-icon": { "iconFontName": "bar-chart-2" }, "al-text": { "content": "Manage Votes" } } },
