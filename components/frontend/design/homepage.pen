                                { "id": "hli-ac-sb-text", "type": "text", "content": "Propose a Project", "fill": "$color.textSecondary", "fontFamily": "$font.mono", "fontSize": 12 }
                              ]
                            },
                            { "id": "hli-ac-deadline", "type": "text", "content": "Proposals close in 12 days", "fill": "$color.accent", "fontFamily": "$font.mono", "fontSize": 10, "textAlign": "center" }
