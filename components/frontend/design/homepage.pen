    {
      "id": "participant-card",
      "name": "Component: Participant Card",
      "context": "Reusable card for participant list. From Figma: avatar, name, title/role, affiliation, optional LinkedIn link, 'Check profile details' button. Maps to User entity (name, email, affiliation, description, role, skills, interests).",
      "type": "frame",
      "reusable": true,
      "x": 6380, "y": 0,
      "width": 800, "height": "fit_content",
      "fill": "$color.surface",
      "stroke": { "align": "inside", "thickness": 1, "fill": "$color.border" },
      "layout": "horizontal", "gap": 16, "alignItems": "center",
