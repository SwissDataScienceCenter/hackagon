                                { "id": "hli-ac-m2", "type": "ellipse", "width": 24, "height": 24, "fill": "$color.surfaceRaised", "stroke": { "align": "outside", "thickness": 2, "fill": "$color.surface" } },
                                { "id": "hli-ac-m3", "type": "ellipse", "width": 24, "height": 24, "fill": "$color.surfaceRaised", "stroke": { "align": "outside", "thickness": 2, "fill": "$color.surface" } }
                              ]
                            },
                            { "id": "hli-ac-team-link", "type": "text", "content": "View Team Page →", "fill": "$color.primary", "fontFamily": "$font.mono", "fontSize": 11, "fontWeight": "500" }
