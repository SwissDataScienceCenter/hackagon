# Upstream sources are fetched, not vendored into git (pinned + SHA-recorded
# by scripts/fetch-upstream.sh, so a fetch is reproducible).
vendor/
.state/

# Admin credentials, generated by scripts/signup.sh on first run. This entry
# matters on feat/claude, where the skill is TRACKED — signup.sh refuses to
# write the file at all if git would not ignore it.
.secrets.env
