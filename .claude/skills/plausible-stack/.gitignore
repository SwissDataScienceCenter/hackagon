# Upstream's compose is fetched, not vendored into git (pinned + SHA-recorded
# by scripts/fetch-upstream.sh, so a fetch is reproducible).
vendor/
.state/

# Admin credentials + SECRET_KEY_BASE, generated by scripts/up.sh on first run.
# This entry is what protects them on a branch where .claude/ is TRACKED —
# secrets.sh refuses to write the file at all if git would not ignore it.
.secrets.env
