# General Outputs
result
.build
.output

# Merge files
*.orig

# macOS Finder metadata
.DS_Store

# Cursor CLI config (machine-specific permissions)
.cursor/cli.json

# Claude local permissions file (machine-specific permissions)
.claude/settings.local.json

# Claude worktrees (nested checkouts of this repo, never part of a commit).
# Also keeps quitsh from discovering the nested `.component.yaml` files, which
# collide by name with the components of the parent checkout.
.claude/worktrees/

## Sensitive Information ======================================================
# All .env files
.env
.env.yaml
# Helm dev values with passwords
helm-chart/values.dev.yaml
helm-chart/charts/

# Keycloak production handover (tools/keycloak-handover). Matched repo-wide, not
# just in that directory, because the scripts take an output path and a generated
# realm dropped elsewhere would otherwise be unprotected.
#
# Placeholders only, but generated — regenerate rather than commit a copy that
# drifts from the dev realm:
realm-hackagon-prod.json
realm-hardening-report.md
# Real admin password and client secret in plain text:
realm-hackagon-prod.filled.json
hackagon-realm-handover.tar
# Every age-encrypted file. If the team later keeps encrypted secrets in git
# (sops-style), negate this for that path rather than dropping the rule.
*.age
